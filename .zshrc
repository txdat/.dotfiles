# ~/.zshrc
# /etc/zshrc is skipped in non-login shells (see ~/.zshenv); anything still
# needed from /etc/profile.d is set here.

# ─── environment ──────────────────────────────────────────────────────────────

[[ -r ~/.env ]] && source ~/.env

export EDITOR="vim --clean"
export KUBECONFIG=$HOME/.kube/config
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
export CHROME_EXECUTABLE=/usr/bin/google-chrome

# gpg-agent needs the terminal name; zsh does not set $TTY
[[ -t 0 ]] && export GPG_TTY=$(tty)

CONDA_HOME=$HOME/miniconda3

typeset -U path
path=(
    $HOME/fvm/bin                                                # flutter
    $HOME/.local/share/fnm                                       # nodejs
    $HOME/.local/share/fnm/aliases/default/bin
    $HOME/go/bin                                                 # go
    $HOME/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin # rust
    $CONDA_HOME/bin                                              # python
    $HOME/.local/bin
    $path
)

export FZF_DEFAULT_OPTS="
 --ansi
 --multi
 --no-separator
 --scrollbar=''
 --info=inline-right
 --height=100%
 --layout=reverse
 --border=none
 --highlight-line
 --pointer=󰁕
 --marker=▶
 --preview-window=right:80%:noborder:hidden
 --bind=ctrl-p:toggle-preview,alt-w:toggle-preview-wrap,alt-j:preview-page-down,alt-k:preview-page-up
"

# ─── history ──────────────────────────────────────────────────────────────────

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt append_history
setopt extended_history
setopt hist_expire_dups_first
setopt hist_find_no_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt share_history

# ─── completion ───────────────────────────────────────────────────────────────

autoload -Uz compinit
# full compinit (with compaudit) at most once a day; otherwise trust the dump
() {
    local dump="${ZDOTDIR:-$HOME}/.zcompdump"
    local -a stale=( $dump(N.mh+24) )
    if (( $#stale )) || [[ ! -f $dump ]]; then
        compinit && touch $dump
    else
        compinit -C
    fi
}

zstyle ':completion:*' matcher-list "m:{a-z}={A-Z}"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# kubectl: cached, regenerated by update_zsh
() {
    local f=~/.zsh/kubectl.completion.zsh
    if [[ ! -s $f ]] && (( $+commands[kubectl] )); then
        mkdir -p $f:h
        kubectl completion zsh > $f 2>/dev/null
    fi
    [[ -s $f ]] && source $f
}
compdef k=kubectl

# gcloud is installed via dnf; only its completion lives in the sdk dir
if [[ -r /usr/lib64/google-cloud-sdk/completion.zsh.inc ]]; then
    source /usr/lib64/google-cloud-sdk/completion.zsh.inc
fi

# ─── plugins ──────────────────────────────────────────────────────────────────

# ctrl-r history, ctrl-t files, alt-c cd
[[ -r /usr/share/fzf/shell/key-bindings.zsh ]] &&
    source /usr/share/fzf/shell/key-bindings.zsh

[[ -r ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
    source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# keep last: this one wraps zle widgets
[[ -r ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
    source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ─── prompt ───────────────────────────────────────────────────────────────────

_git_branch() {
    local b
    b=$(git symbolic-ref --short HEAD 2>/dev/null) && echo -n "$b "
}

setopt prompt_subst
PROMPT='%F{green}%n@%m%f %F{blue}%~%f%F{white} $(_git_branch)%f❯ '

# ─── keybindings (vi mode) ────────────────────────────────────────────────────

bindkey -v
bindkey ' '    magic-space                       # expand history on space
bindkey '^[[A' history-beginning-search-backward # up: match typed prefix
bindkey '^[[B' history-beginning-search-forward  # down
bindkey '^I'   complete-word                     # tab
bindkey '^[[Z' autosuggest-accept                # shift+tab
bindkey '^?'   backward-delete-char              # backspace

# ─── aliases ──────────────────────────────────────────────────────────────────

alias k=kubectl
alias dsh="npx @deepseek-ai/dsh web --no-open"

# ─── functions ────────────────────────────────────────────────────────────────

# lazy-load conda: run its shell hook on first use
conda() {
    unfunction conda
    local setup
    if setup="$("$CONDA_HOME/bin/conda" shell.zsh hook 2>/dev/null)"; then
        eval "$setup"
    elif [[ -f $CONDA_HOME/etc/profile.d/conda.sh ]]; then
        source "$CONDA_HOME/etc/profile.d/conda.sh"
    fi
    conda "$@"
}

# claude wrapper: model/telemetry defaults plus shorthands
#   -d         skip permission prompts
#   --ak=IDX   token from the CLAUDE_API_KEY json array (or object key)
#   --ds       deepseek endpoint and models
claude() {
    local -a env_vars=(
        CLAUDE_CODE_ENABLE_TELEMETRY=0
        CLAUDE_CODE_AUTO_COMPACT_WINDOW=300000
        CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=1
        CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
        CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT=1
        CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
        ENABLE_LSP_TOOL=1
        ENABLE_CLAUDEAI_MCP_SERVERS=false
    )
    local -a args=()
    args+=(--dangerously-skip-permissions)
    local arg pro_model flash_model token
    for arg in "$@"; do
        case $arg in
            --ak=*)
                token=$(print -r -- "$CLAUDE_API_KEY" |
                    jq -r -e --arg key "${arg#*=}" \
                        'if type == "array" then .[$key | tonumber] else .[$key] end') ||
                    { print -u2 "claude: no token '${arg#*=}' in CLAUDE_API_KEY"; return 1 }
                env_vars+=("ANTHROPIC_AUTH_TOKEN=$token")
                ;;
            --ds)
                pro_model="deepseek-v4-pro"
                flash_model="deepseek-flash"
                env_vars+=(
                    "ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic"
                    "ANTHROPIC_AUTH_TOKEN=$DEEPSEEK_API_KEY"
                    "ANTHROPIC_DEFAULT_FABLE_MODEL=${pro_model}"
                    "ANTHROPIC_DEFAULT_OPUS_MODEL=${pro_model}"
                    "ANTHROPIC_DEFAULT_SONNET_MODEL=${flash_model}"
                    "ANTHROPIC_DEFAULT_HAIKU_MODEL=${flash_model}"
                )
                ;;
            --oc)
                env_vars+=(
                    "ANTHROPIC_BASE_URL=https://opencode.ai/inference/go/anthropic"
                    "ANTHROPIC_AUTH_TOKEN=$OPENCODE_API_KEY"
                    "ANTHROPIC_DEFAULT_FABLE_MODEL=deepseek-v4-pro"
                    "ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro"
                    "ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4.1-flash"
                    "ANTHROPIC_DEFAULT_HAIKU_MODEL=mimo-v2.6-flash"
                )
                ;;
            # -d) args+=(--dangerously-skip-permissions) ;;
            *)  args+=("$arg") ;;
        esac
    done
    env "${env_vars[@]}" command claude "${args[@]}"
}

agy() {
    local -a args=()
    args+=(--dangerously-skip-permissions)
    local arg
    for arg in "$@"; do
        case $arg in
            # -d) args+=(--dangerously-skip-permissions) ;;
            *)  args+=("$arg") ;;
        esac
    done
    command agy "${args[@]}"
}

codex() {
    local -a args=()
    args+=(--yolo)
    local arg
    for arg in "$@"; do
        case $arg in
            -r|--resume) args+=(resume) ;;
            # -d)          args+=(--yolo) ;;
            *)           args+=("$arg") ;;
        esac
    done
    command codex "${args[@]}"
}

# clipboard: xc -f FILE | xc -o [FILE] | cmd | xc
xc() {
    case $1 in
        -f|--file) xclip -selection clipboard < "$2" ;;
        -o|--out)
            if [[ -n $2 ]]; then
                xclip -selection clipboard -o > "$2"
            else
                xclip -selection clipboard -o
            fi
            ;;
        *) xclip -selection clipboard "$@" ;;
    esac
}

md2pdf() {
    if [[ -z $1 ]]; then
        print -u2 "usage: md2pdf FILE.md"
        return 1
    fi
    local src=$1
    local out=${src%.md}.pdf
    local tmp
    tmp=$(mktemp --suffix=.md) || return
    npx prettier "$src" > "$tmp" &&
        pandoc "$tmp" -o "$out" \
            --pdf-engine=lualatex \
            --template=eisvogel \
            -V mainfont='NotoSans-Regular' \
            -V monofont='NotoSansMono-Regular' \
            -V fontsize=9pt \
            -V header-includes='
\directlua{luaotfload.add_fallback("fb", {"[NotoSans-Regular.ttf]", "[NotoSansMono-Regular.ttf]"})}
\AtBeginDocument{%
  \setmainfont[RawFeature={fallback=fb}]{NotoSans-Regular}%
  \setmonofont[RawFeature={fallback=fb}]{NotoSansMono-Regular}%
}
'
    local rc=$?
    rm -f "$tmp"
    return $rc
}

update_zsh() {
    local plg
    for plg in zsh-syntax-highlighting zsh-autosuggestions; do
        (cd ~/.zsh/$plg && git pull)
    done
    # regenerate cached kubectl completion after kubectl updates
    (( $+commands[kubectl] )) &&
        kubectl completion zsh > ~/.zsh/kubectl.completion.zsh 2>/dev/null
}
