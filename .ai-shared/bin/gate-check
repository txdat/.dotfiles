#!/bin/bash
# Gate checker — enforces dev skill workflow state-machine transitions.
# Reads PreToolUse hook JSON from stdin, validates gate conditions per skill,
# and outputs blocking JSON if a gate fails.
#
# Valid transitions:
#   design-feature  → planning
#   review-feature  → planning (self-correction, no status flip)
#   (human approve) → approved (manual, or confirmed at ship-feature's plan-phase PAUSE)
#   execute-feature → approved → in-progress → implemented
#   review-code     → implemented → reviewed
#   create-pr       → reviewed → archived
#   fix-bug          → read-only diagnosis and routing, no plan gate
#   (human abandon) → abandoned (terminal; any non-archived status)
#
# Each skill's entry gate is the prerequisite status.
# archived and abandoned are the two terminal statuses: both leave the active
# set, and neither is an entry status for any skill, so an abandoned plan
# blocks at whatever gate it is aimed at.
# Review-code additionally requires proof-commit sequencing for every slice.
#
# Approval is a human decision recorded as `Status: approved`, set at the
# spec-approval pause (see skills/dev/approval.md). The hook checks that the
# status is there before execution. It cannot tell who wrote the field, and it
# deliberately does not validate plan prose. The AC/TC/Step ID graph is checked
# for referential closure (see traceability_report) — identifiers only. Whether
# the ACs are right, whether a TC can admit a wrong implementation, and whether
# a step actually satisfies the TC it cites are judgment calls owned by
# review-feature's judgment, not by a parser.
#
# Plan resolution is by explicit path only (see resolve_plan). Governance binds
# to a named artifact: a plan-consuming skill either names its
# docs/plans/<file>.md or blocks asking for it. No slug matching, no session
# pin, no lone-plan adoption — a dormant plan can never capture unrelated work,
# and a gate never fires merely because some plan exists in the repository.
#
# Plan storage and archive rules: skills/dev/plan.md. Gates read the live
# main-tree plan; proof checks use the worktree HEAD (the slice branch).

set -euo pipefail

if ! command -v jq >/dev/null 2>&1; then
  printf '{"continue":false,"stopReason":"gate-check requires jq to parse hook input.","decision":"block","reason":"gate-check requires jq to parse hook input."}\n'
  exit 0
fi

# find_explicit_plan canonicalises with realpath -m; without it every plan
# would fail to resolve and report as "no plan named", which hides the real
# cause. Probe the flag, not just the binary — macOS ships a realpath without
# -m, and `command -v` alone would pass it.
if ! realpath -m -- / >/dev/null 2>&1; then
  printf '{"continue":false,"stopReason":"gate-check requires realpath with -m support (GNU coreutils) to validate plan paths.","decision":"block","reason":"gate-check requires realpath with -m support (GNU coreutils) to validate plan paths."}\n'
  exit 0
fi

HOOK_INPUT=$(cat)

DEV_SKILL_SLUG_RE='create-issue|create-pr|design-feature|design-infra|design-system|execute-feature|explore|fix-bug|frame-goal|review-code|review-feature|review-infra|review-system|ship-feature'

is_dev_skill_slug() {
  [[ "$1" =~ ^($DEV_SKILL_SLUG_RE)$ ]]
}

emit_skill_slug() {
  local slug="$1"
  is_dev_skill_slug "$slug" || return 1
  echo "$slug"
}

extract_skill_slug() {
  local raw="${1#/}"
  raw="${raw,,}"
  raw="${raw//_/-}"

  case "$raw" in
    dev:*) emit_skill_slug "${raw#dev:}" && return 0 ;;
    dev-*) emit_skill_slug "${raw#dev-}" && return 0 ;;
  esac

  if [[ "$raw" =~ dev[:-]($DEV_SKILL_SLUG_RE) ]]; then
    emit_skill_slug "${BASH_REMATCH[1]}" && return 0
  fi

  if [[ "$raw" =~ (^|[[:space:]/])($DEV_SKILL_SLUG_RE)([[:space:]]|$) ]]; then
    emit_skill_slug "${BASH_REMATCH[2]}" && return 0
  fi

  echo ""
}

RAW_SKILL=$(
  jq -r '
    [
      .tool_input.skill?,
      .tool_input.skill_name?,
      .tool_input.name?,
      .tool_input.command?,
      .tool_input.arguments?,
      .skill?,
      .skill_name?,
      .arguments.skill?,
      .command?
    ]
    | map(select(type == "string" and length > 0))
    | .[0] // ""
  ' <<<"$HOOK_INPUT" 2>/dev/null || true
)
SKILL_SLUG=$(extract_skill_slug "$RAW_SKILL")
[[ -n "$SKILL_SLUG" ]] || exit 0
STATUS=""
PLAN=""
ACTIVE_WORKTREE=""

block() {
  local reason="$1"
  jq -cn --arg reason "$reason" \
    '{continue:false, stopReason:$reason, decision:"block", reason:$reason}'
  exit 0
}

# Share root resolution with phase skills; never substitute the linked tree.
GATE_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
REPO_ROOT=$(bash "$GATE_DIR/dev-utils.sh" main-root 2>/dev/null) || block "Cannot resolve the main working-tree root. Follow skills/dev/plan.md; do not substitute the current linked worktree."
cd "$REPO_ROOT" || block "Cannot access the main working-tree root: $REPO_ROOT"
# Tree that git history checks run against — repointed to the plan's worktree
# when one is recorded (see "Worktree model" above).
GIT_TREE="$REPO_ROOT"

HOOK_TEXT=$(
  jq -r '
    [
      .tool_input.arguments?,
      .tool_input.command?,
      .arguments?,
      .command?,
      .prompt?
    ]
    | map(select(type == "string"))
    | join(" ")
  ' <<<"$HOOK_INPUT" 2>/dev/null || true
)

# ── helpers ───────────────────────────────────────────────────────────

# "Exact path" has to mean exact. A bare substring match would accept
# /another/repo/docs/plans/x.md (matching from its own "docs/plans/" and then
# resolving *this* repo's file) and docs/plans/../escape.md, and would pick a
# plan out of surrounding prose. Canonicalise and require a direct child of
# $REPO_ROOT/docs/plans.
#
# Known limit: the hook reads tokens, not intent. A valid plan path *mentioned*
# in free text still resolves ("ship-feature follow up on docs/plans/old.md
# but different" adopts old.md), and when two paths appear the first wins
# silently. Both are the caller's ambiguity to avoid — the skills' contract is
# one named plan per invocation — and a parser cannot tell mention from naming.
find_explicit_plan() {
  local candidate real base
  [[ "$HOOK_TEXT" =~ (^|[[:space:]])([^[:space:]]*docs/plans/[^[:space:]]+\.md) ]] || return 1
  candidate="${BASH_REMATCH[2]}"
  real=$(realpath -m -- "$candidate" 2>/dev/null) || return 1
  base=$(realpath -m -- "$REPO_ROOT/docs/plans" 2>/dev/null) || return 1
  # Direct child only: no nesting, no traversal, no other repository.
  [[ "$real" == "$base/"* && "${real#"$base"/}" != */* ]] || return 1
  [[ -f "$real" ]] || return 1
  # Emit the repo-relative form the rest of the script expects.
  printf '%s\n' "docs/plans/${real#"$base"/}"
}

# A bare path was given but resolves to no file (e.g. "docs/plans/x.md" typo).
explicit_path_given_but_missing() {
  [[ "$HOOK_TEXT" =~ docs/plans/[^[:space:]]+\.md ]] || return 1
  find_explicit_plan >/dev/null 2>&1 && return 1
  return 0
}

# Plan resolution is by explicit path, and only by explicit path.
#
# Ambient resolution — unique-slug matching, a session pin, adopting the lone
# active plan — used to make plan-taking skills convenient. It also meant a
# dormant plan sitting in docs/plans/ could capture unrelated work, and that a
# gate fired because a plan existed *somewhere in the repository* rather than
# because this invocation was about that plan. Governance now binds to a named
# artifact: the caller says which plan, or the command blocks asking for one.
resolve_plan() {
  find_explicit_plan 2>/dev/null
}

plan_status() {
  awk '
    /^Status:/ {
      sub(/^Status:[[:space:]]*/, "")
      sub(/[[:space:]]*\|.*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      print
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Type — feature | fix | refactor (lives on the Status line:
# "Status: ... | Type: <type> | Issue:"). Distinct from PR Pattern's single/chain.
plan_type() {
  awk '
    /^Status:/ {
      if (match($0, /Type:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Type:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print tolower(t)
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Issue value (same Status line: "... | Issue: <ref> | Worktree:").
plan_issue() {
  awk '
    /^Status:/ {
      if (match($0, /Issue:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Issue:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print t
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Base branch (same Status line: "... | Base: <branch> | ...").
plan_base() {
  awk '
    /^Status:/ {
      if (match($0, /Base:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Base:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print t
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Worktree path (same Status line: "... | Worktree: <path> | ...").
plan_worktree() {
  awk '
    /^Status:/ {
      if (match($0, /Worktree:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Worktree:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print t
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# True when the Issue field holds a real issue reference — the skills require
# "#<number>", so anything without one (empty, none, TBD, placeholder) fails.
has_issue() {
  local v
  v=$(plan_issue "$1")
  [[ "$v" =~ ^\#[1-9][0-9]*$ ]]
}

is_registered_worktree() {
  local target="$1" line
  [[ "$target" != "$REPO_ROOT" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == "worktree $target" ]] && return 0
  done < <(git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null)
  return 1
}

open_questions_count() {
  # Count unresolved entries after "Open Questions:" only. Assumptions in the
  # same section are not open questions.
  awk '
    function trim(s) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      return s
    }
    function is_empty_marker(s) {
      s = tolower(trim(s))
      return s == "" || s == "none" || s == "n/a" || s == "empty" || s == "no unresolved" || s == "<none>" || s == "<n/a>"
    }
    /^## Assumptions & Open Questions/ { in_section=1; next }
    /^## / && in_section { exit }
    !in_section { next }
    /^Open Questions:/ {
      in_open=1
      line=$0
      sub(/^Open Questions:[[:space:]]*/, "", line)
      line=trim(line)
      if (line != "" && line !~ /^<.*MUST be empty.*>$/ && !is_empty_marker(line)) {
        count++
      }
      next
    }
    in_open && /^[[:alpha:]][[:alpha:] ]*:/ { in_open=0; next }
    in_open {
      line=trim($0)
      if (line == "" || line ~ /^<!--/) next
      sub(/^[-*][[:space:]]+/, "", line)
      if (line !~ /^<.*>$/ && !is_empty_marker(line)) count++
    }
    END { print count+0 }
  ' "$1" 2>/dev/null
}

# Referential closure of the AC <-> TC <-> Step ID graph. This reads
# identifiers, never prose: it proves every ID is referenced, never that any
# edge is *true* (whether a Proves: names the right AC, whether a step
# satisfies the TC it cites). That stays review-feature's judgment.
#
# Two output classes, and the caller must keep them apart. A line prefixed `!`
# means the graph could not be read at all (ID ranges, a missing section, an
# unparseable Proves:) — a parser that cannot read the graph must say so, not
# report a defect, because a false traceability block teaches the reader to
# distrust the hook. Everything else is a real unreferenced-ID finding.
traceability_report() {
  awk '
    function trim(s) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      return s
    }
    /^## / { sec = "" }
    /^## Acceptance Criteria/  { sec = "ac";   next }
    /^## Test Cases/           { sec = "tc";   next }
    /^## Implementation Steps/ { sec = "step"; next }
    sec == "" { next }

    # design-feature.md requires enumerated IDs precisely so this graph is
    # readable. A range collapses IDs the parser must see individually, so it
    # is unreadable input, not an unreferenced ID. Both operands must be IDs
    # (or a "through"/"to" keyword) — otherwise "TC-1 - 200 returned" trips it.
    # "to" appears in both alternatives: with an ID on each side ("TC-1 to
    # TC-4") only the first can match, and missing it there would let the range
    # decay into unreferenced-ID findings for the collapsed middle IDs — the
    # false verdict this class exists to prevent.
    /(AC|TC)-[0-9]+[[:space:]]*(through|thru|to|\.\.|–|—|-)[[:space:]]*(AC|TC)-[0-9]+/ ||
    /(AC|TC)-[0-9]+[[:space:]]+(through|thru|to)[[:space:]]+[0-9]+/ {
      printf "!line %d uses an ID range (%s) — enumerate IDs so traceability can be checked\n", NR, trim($0)
      unreadable = 1
    }

    sec == "ac" && /^[[:space:]]*([-*][[:space:]]*)?AC-[0-9]+/ {
      match($0, /AC-[0-9]+/)
      id = substr($0, RSTART, RLENGTH)
      # A reused ID is two ACs wearing one name: silently collapsing them drops
      # a criterion from the graph, so it is unreadable input, not an orphan.
      if (id in ac) {
        printf "!%s is declared more than once (line %d) — IDs must be unique\n", id, NR
        unreadable = 1
      } else { ac[id] = 1; acorder[++nac] = id }
      next
    }

    sec == "tc" && /^[[:space:]]*([-*][[:space:]]*)?TC-[0-9]+/ {
      match($0, /TC-[0-9]+/)
      curtc = substr($0, RSTART, RLENGTH)
      if (curtc in tc) {
        printf "!%s is declared more than once (line %d) — IDs must be unique\n", curtc, NR
        unreadable = 1
      } else {
        tc[curtc] = 1; tcorder[++ntc] = curtc; proves[curtc] = ""; provesline[curtc] = 0
      }
      next
    }
    sec == "tc" && /^[[:space:]]*([-*][[:space:]]*)?Proves:/ {
      if (curtc == "") next
      line = $0
      sub(/^[[:space:]]*([-*][[:space:]]*)?Proves:[[:space:]]*/, "", line)
      line = trim(line)
      n = 0; tmp = line
      while (match(tmp, /AC-[0-9]+/)) {
        n++
        last = substr(tmp, RSTART, RLENGTH)
        tmp = substr(tmp, RSTART + RLENGTH)
      }
      # Exactly one Proves: per TC, naming exactly one AC. A second line would
      # otherwise overwrite the first and the plan would read as well-formed.
      if (provesline[curtc] > 0) {
        printf "!%s has more than one Proves: line (lines %d and %d) — exactly one is required\n", curtc, provesline[curtc], NR
        unreadable = 1
      }
      provesline[curtc] = NR
      if (n == 0) {
        printf "!%s has an unparseable Proves: line (%s)\n", curtc, line
        unreadable = 1
      } else if (n > 1) {
        printf "!%s names %d ACs in Proves: — exactly one is required\n", curtc, n
        unreadable = 1
      } else {
        proves[curtc] = last
      }
      next
    }

    sec == "step" && /^[[:space:]]*([-*][[:space:]]*)?Step[[:space:]]+[0-9]+/ {
      cur = ++nstep
      stepline[cur] = NR
      steptxt[cur] = trim($0)
      stepref[cur] = 0
      # Steps are keyed by occurrence, but their numbers are still IDs that
      # TC mappings cite ("satisfies TC-3" lives on a numbered step). A reused
      # number is two steps wearing one name — the same unreadable input as a
      # duplicate AC/TC ID, not a closure finding.
      match($0, /Step[[:space:]]+[0-9]+/)
      # Numeric key, so "Step 01" and "Step 1" collide as they should.
      num = trim(substr($0, RSTART + 4, RLENGTH - 4)) + 0
      if (num in stepnum) {
        printf "!Step %s is declared more than once (line %d) — step numbers must be unique\n", num, NR
        unreadable = 1
      } else stepnum[num] = 1
    }
    sec == "step" && cur > 0 {
      tmp = $0
      while (match(tmp, /TC-[0-9]+/)) {
        id = substr(tmp, RSTART, RLENGTH)
        referenced[id] = 1
        stepref[cur]++
        # Record where an undeclared ID was cited; whether it is declared can
        # only be judged in END, since ## Test Cases may follow ## Steps.
        if (!(id in stepcite)) { stepcite[id] = NR }
        tmp = substr(tmp, RSTART + RLENGTH)
      }
    }

    END {
      if (nac == 0)   { print "!no AC- entries under ## Acceptance Criteria"; unreadable = 1 }
      if (ntc == 0)   { print "!no TC- entries under ## Test Cases";          unreadable = 1 }
      if (nstep == 0) { print "!no Step entries under ## Implementation Steps"; unreadable = 1 }
      # Unreadable input cannot produce a trustworthy closure verdict: reporting
      # orphans derived from IDs we failed to parse is the false block above.
      if (unreadable) exit
      for (i = 1; i <= nac; i++) {
        id = acorder[i]; found = 0
        for (j = 1; j <= ntc; j++) if (proves[tcorder[j]] == id) found = 1
        if (!found) printf "%s has no TC — no Test Case names it in Proves:\n", id
      }
      for (j = 1; j <= ntc; j++) {
        id = tcorder[j]; p = proves[id]
        if (p == "") printf "%s has no Proves: line — every TC names exactly one AC\n", id
        else if (!(p in ac)) printf "%s names %s in Proves:, which is not in ## Acceptance Criteria\n", id, p
        if (!(id in referenced)) printf "%s is not named by any Implementation Step\n", id
      }
      for (i = 1; i <= nstep; i++) {
        if (stepref[i] == 0) printf "step at line %d names no TC: %s\n", stepline[i], steptxt[i]
      }
      # A step citing an undeclared TC satisfies "names a TC" without the edge
      # existing, which would let a step own nothing while appearing to own one.
      for (id in stepcite) {
        if (!(id in tc)) printf "step at line %d names %s, which is not declared in ## Test Cases\n", stepcite[id], id
      }
    }
  ' "$1" 2>/dev/null
}

# Blocks on either output class, with different messages: an unreadable plan is
# a shape defect to fix, never a traceability verdict.
require_traceability() {
  local report
  report=$(traceability_report "$1")
  [[ -n "$report" ]] || return 0
  if [[ "$report" == *$'\n'!* || "$report" == !* ]]; then
    block "$(printf 'gate-check cannot read this plan'"'"'s AC/TC/Step ID graph — fix the plan shape and re-run. This is NOT a traceability verdict:\n%s' "$(sed 's/^!//' <<<"$report")")"
  fi
  block "$(printf "Plan's AC/TC/Step graph is not closed — every AC needs a TC, every TC a Proves: and a step, every step a TC:\n%s\n\nClosure is shape, not correctness: fixing these does not mean an edge is right." "$report")"
}

red_commit_count() {
  local base="$1"
  git -C "$GIT_TREE" log --format=%s "${base}..HEAD" 2>/dev/null | grep -Ec '^test\(red\):' || true
}

# Refactor slices prove TDD with a passing "test: baseline <scope>" commit
# instead of a failing test(red): commit.
baseline_commit_count() {
  local base="$1"
  git -C "$GIT_TREE" log --format=%s "${base}..HEAD" 2>/dev/null | grep -Ec '^test:[[:space:]]*baseline' || true
}

proof_sequence_ok() {
  local base="$1" mode="$2" expected="$3" proof_re=""
  case "$mode" in
    red) proof_re='^test\\(red\\):' ;;
    baseline) proof_re='^test:[[:space:]]*baseline' ;;
    *) return 1 ;;
  esac

  git -C "$GIT_TREE" log --format='%s' --reverse "${base}..HEAD" 2>/dev/null | awk \
    -v proof_re="$proof_re" \
    -v expected="$expected" '
      BEGIN { proofs=0; waiting_for_impl=0; seen_proof=0; bad=0 }
      $0 ~ proof_re {
        if (waiting_for_impl) bad=1
        proofs++
        waiting_for_impl=1
        seen_proof=1
        next
      }
      {
        if (!seen_proof) bad=1
        if (waiting_for_impl) waiting_for_impl=0
      }
      END {
        if (proofs < expected || waiting_for_impl || bad) exit 1
      }
    '
}

slice_count() {
  local plan="$1"
  awk '
    /^## PR Pattern/ { in_pattern=1; next }
    /^## / && in_pattern { exit }
    in_pattern && /^\|[[:space:]]*[0-9]+[[:space:]]*\|/ { count++ }
    END { print count+0 }
  ' "$plan" 2>/dev/null
}

has_final_pr_pattern() {
  local plan="$1"
  grep -q '^## PR Pattern$' "$plan" 2>/dev/null && ! grep -q '^## PR Pattern (provisional)$' "$plan" 2>/dev/null
}

# One line per PR-Pattern row, in table order: that row's Parent, or empty
# when the column or the cell is missing. Callers decide which absence matters.
plan_parents() {
  awk '
    function trim(s) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      return s
    }
    /^## PR Pattern/ { in_pattern=1; next }
    /^## / && in_pattern { exit }
    in_pattern && /^\|/ {
      n=split($0, cells, "|")
      if (trim(cells[2]) ~ /^[0-9]+$/) {
        print parent_col ? trim(cells[parent_col]) : ""
        next
      }
      for (i=2; i<=n; i++)
        if (trim(cells[i]) == "Parent") parent_col=i
    }
  ' "$1" 2>/dev/null
}

# The integration Base can exclude an unmerged parent. Proof for this plan
# starts at the first slice's explicit Parent, including for a single PR.
plan_first_parent() {
  # awk, not head: head exits early, and the SIGPIPE it can hand back would
  # fail the capturing assignment under set -e and pipefail.
  plan_parents "$1" | awk 'NR==1'
}

# Rows whose Parent is missing. design-feature requires one on every row, and
# create-pr targets each PR at it, so a gap anywhere is a defect.
parentless_row_count() {
  # Piped, not captured: $( ) strips trailing newlines, which would hide a
  # missing parent on the last row — the row most likely to be added late.
  plan_parents "$1" | grep -c '^[[:space:]]*$' || true
}

# ── gate dispatch ─────────────────────────────────────────────────────

# Resolve the named plan only for skills that consume one. Entry skills
# (frame-goal, design-*, explore, create-issue, fix-bug) do not bind to an
# application plan, even if their context mentions one.
case "$SKILL_SLUG" in
  review-feature|execute-feature|review-code|create-pr|ship-feature)
    PLAN=$(resolve_plan 2>/dev/null || true) ;;
  *)
    PLAN="" ;;
esac
# Keep PLAN bound to the root source; only Git checks move into the worktree.
if [[ -n "$PLAN" ]]; then
  WT=$(plan_worktree "$PLAN")
  case "${WT,,}" in ""|none|n/a|"<"*">") WT="" ;; esac
  if [[ -n "$WT" ]]; then
    if ! is_registered_worktree "$WT"; then
      block "Plan records 'Worktree: $WT', but that path is not a registered non-main Git worktree. Preserve the plan and resolve registration per skills/dev/plan.md#worktree-operations before retrying."
    elif [[ -d "$WT" ]]; then
      GIT_TREE="$WT"
      ACTIVE_WORKTREE="$WT"
    else
      block "Plan records 'Worktree: $WT' but the worktree directory is missing. Preserve the root plan and restore the worktree per skills/dev/plan.md#worktree-operations before continuing."
    fi
  fi
  STATUS=$(plan_status "$PLAN")
fi

# A plan-consuming skill must name its artifact. The block never inspects how
# many plans exist: "which plan did you mean" is the caller's answer to give,
# and counting them is how a dormant plan used to capture unrelated work.
require_plan() {
  [[ -n "$PLAN" ]] && return 0
  if explicit_path_given_but_missing; then
    block "Named plan not found. Pass an existing docs/plans/<file>.md."
  fi
  block "${SKILL_SLUG} operates on a plan and none was named. Pass its exact path: ${SKILL_SLUG} docs/plans/<file>.md. A slug, a previously used plan, or the only plan in docs/plans/ will not resolve — the path is required. No plan yet → run design-feature first."
}

require_worktree() {
  [[ -n "$ACTIVE_WORKTREE" ]] && return 0
  block "Plan has no active registered Worktree. Run the appropriate execute skill to create it before ${SKILL_SLUG}."
}

case "$SKILL_SLUG" in

  # ── review-feature: plan must be planning ──
  review-feature)
    require_plan
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        planning) ;;
        approved) block "Plan is already approved. Run execute-feature next." ;;
        implemented|reviewed)             block "Plan status is '$STATUS' — too late for review-feature. Continue forward." ;;
        archived)              block "Plan is shipped. Nothing to review." ;;
        *)                                block "Plan status is '$STATUS' — expected 'planning'. Run design-feature first." ;;
      esac
      OQ=$(open_questions_count "$PLAN")
      if [[ "$OQ" -gt 0 ]]; then
        block "Plan has $OQ unresolved Open Question(s). Resolve them in design-feature before review."
      fi
      # design-feature owns issue creation, so the omission surfaces here rather
      # than at execution — after review and approval have already been spent.
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field in the plan header is empty. Link an existing issue (a parent issue may back several plans) or create one ('gh issue create'); record it as 'Issue: #<n>', then re-run."
      fi
      require_traceability "$PLAN"
      # Parents are required here, not at review-code: a gap caught at
      # 'implemented' blocks a plan whose execution is already finished, over a
      # table cell design should have written. Row 1's is review-code's review
      # base; later rows are what create-pr targets each PR at.
      if [[ -n "$(plan_first_parent "$PLAN")" ]]; then
        PARENTLESS=$(parentless_row_count "$PLAN")
        [[ "$PARENTLESS" -eq 0 ]] || block "Plan PR Pattern leaves $PARENTLESS slice row(s) without a Parent. Every row records its own (design-feature 'PR Pattern'): normally the preceding branch, or the Base branch for row 1."
      else
        block "Plan PR Pattern has no Parent for row 1. Give every slice an explicit parent (design-feature 'PR Pattern') — normally the Base branch, or an unmerged PR's branch when this plan builds on one."
      fi
    fi
    ;;

  # ── execute-feature: plan must be approved (or in-progress for resume) ──
  execute-feature)
    require_plan
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        approved|in-progress) ;;
        planning) block "Plan status is '$STATUS' — not approved. Run review-feature, then have the user approve the spec (see approval.md)." ;;
        implemented)                      block "Plan is already implemented. Run review-code next." ;;
        reviewed)                         block "Plan status is '$STATUS' — already past execution. Run review-code or create-pr." ;;
        archived)              block "Plan is shipped. Nothing to execute." ;;
        *)                                block "Plan status is '$STATUS' — expected 'approved' or 'in-progress'." ;;
      esac
      # Every plan (feature/fix/refactor) must be issue-backed before implementation.
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field in the plan header is empty. Link an existing issue (a parent issue may back several plans) or create one ('gh issue create'); record it as 'Issue: #<n>', then re-run."
      fi
    fi
    ;;

  # ── review-code: plan must be implemented + RED commit must exist ──
  review-code)
    require_plan
    require_worktree
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        implemented) ;;
        planning|approved|in-progress)
          block "Plan status is '$STATUS' — not yet implemented. Run the appropriate execute skill first." ;;
        reviewed)      block "Plan is already reviewed. Run create-pr next." ;;
        archived) block "Plan is shipped. Nothing to review." ;;
        *)             block "Plan status is '$STATUS' — expected 'implemented'." ;;
      esac
      # Re-review authority and non-convergence belong to independence.md.
      # A header counter is not evidence of readiness or authorization.
      # Catches plans that entered implemented without the normal execution gate.
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field in the plan header is empty. Link an existing issue or create one ('gh issue create'), record it as 'Issue: #<n>', then re-run."
      fi
      # Re-checked here, not just at review-feature: the plan is edited between
      # the two (Deviations, Coverage Gaps, a TC added mid-flight), so a TC that
      # gained no owning step during execution would otherwise never be caught.
      require_traceability "$PLAN"
    fi
    BASE=$(plan_base "$PLAN")
    [[ -n "$BASE" ]] || block "Plan has no Base branch — the 'Base:' field in the plan header is empty. Set it to the branch this work is based off, then re-run."
    REVIEW_BASE=$(plan_first_parent "$PLAN")
    [[ -n "$REVIEW_BASE" ]] || block "Plan PR Pattern has no first-slice Parent — record the explicit parent before code review."
    git -C "$GIT_TREE" merge-base --is-ancestor "$REVIEW_BASE" HEAD 2>/dev/null || block "Plan PR Pattern Parent '$REVIEW_BASE' is missing or is not an ancestor of the reviewed branch."
    SLICES=$(slice_count "$PLAN")
    [[ "$SLICES" -gt 0 ]] || SLICES=1
    PLAN_TYPE=$(plan_type "$PLAN")
    if [[ "$PLAN_TYPE" == "refactor" ]]; then
      BASELINES=$(baseline_commit_count "$REVIEW_BASE")
      if [[ "$BASELINES" -lt "$SLICES" ]]; then
        block "Found $BASELINES 'test: baseline' commit(s) between $REVIEW_BASE and HEAD; expected at least $SLICES for the plan slice count. Commit the passing baseline before refactor review."
      fi
      if ! proof_sequence_ok "$REVIEW_BASE" baseline "$SLICES"; then
        block "Baseline proof is out of sequence. Each slice must have a 'test: baseline' commit followed by at least one refactor commit before the next slice."
      fi
    else
      REDS=$(red_commit_count "$REVIEW_BASE")
      if [[ "$REDS" -lt "$SLICES" ]]; then
        block "Found $REDS test(red) commit(s) between $REVIEW_BASE and HEAD; expected at least $SLICES for the plan slice count. Run RED phase before code review."
      fi
      if ! proof_sequence_ok "$REVIEW_BASE" red "$SLICES"; then
        block "RED/GREEN proof is out of sequence. Each slice must have a 'test(red)' commit followed by at least one implementation commit before the next slice."
      fi
    fi
    ;;

  # ── create-pr: plan must be reviewed ──
  create-pr)
    require_plan
    require_worktree
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        reviewed) ;;
        implemented)           block "Plan status is 'implemented' — run review-code first." ;;
        planning|approved|in-progress) block "Plan status is '$STATUS' — not yet executed. Continue the workflow." ;;
        archived)   block "PR already exists for this plan." ;;
        *)                     block "Plan status is '$STATUS' — expected 'reviewed'." ;;
      esac
      if ! has_final_pr_pattern "$PLAN"; then
        block "Plan PR Pattern is missing or still provisional. Run review-code to finalize it before create-pr."
      fi
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field must hold '#<n>' before a PR can reference it. Link an existing issue or create one ('gh issue create'), record it, then re-run."
      fi
    fi
    ;;

  # ── ship-feature: reject already-shipped ──
  ship-feature)
    if [[ -n "$PLAN" ]]; then
      [[ "$STATUS" == "archived" ]] && block "Plan is already archived — feature has already shipped."
    fi
    ;;

  # ── planning and read-only entry points: no entry gate ──
  design-feature|design-system|review-system|design-infra|review-infra|explore|create-issue|fix-bug)
    # Entry-point skills: read-only, or they produce a plan/issue/architecture
    # doc rather than touching application code. Nothing that mutates
    # application code reaches this branch — that is what makes PROCESS.md's
    # "no planless mutation" true. The architecture lane (design-system,
    # review-system) works on docs/architecture/ and has no plan state; the
    # infra lane (design-infra, review-infra) works on docs/runbooks/ and has
    # none either. Both are listed rather than left to fall off the slug
    # regex, so the ungated set stays explicit and auditable.
    ;;

  *) exit 0 ;;
esac

exit 0
