#!/bin/bash
# Gate checker — enforces dev skill workflow state-machine transitions.
# Reads hook JSON from stdin, validates gate conditions per skill, and outputs
# blocking JSON if a gate fails. Two events reach it: PreToolUse for a
# model-invoked Skill call (the skill's argument string is tool_input.args;
# the Pi extension sends tool_input.arguments), and UserPromptSubmit for a
# user-typed /dev-<skill> command, which expands without any Skill tool call.
#
# Plan states and the end of delivery: ../skills/dev/plan.md#lifecycle.
# Required delivery phases: ../PROCESS.md#delivery.
# Each skill's entry gate checks its prerequisite status.
# review-feature requires planning and leaves that status unchanged (../skills/dev/review-feature.md).
# fix-bug has no plan gate; it diagnoses and routes (../skills/dev/fix-bug.md).
# Review-code additionally requires proof-commit sequencing for every slice.
# A live plan is untracked. A plan tracked in the main root is a published
# record, so no plan-consuming skill resumes it (../skills/dev/plan.md#lifecycle).
#
# Approval is the user's action: only the user sets `Status: approved`
# (../skills/dev/plan.md#lifecycle). The hook checks that the status is there
# before execution. It cannot tell who wrote the field, and it
# deliberately does not validate plan prose. Artifact IDs (../skills/dev/ids.md)
# are checked for format and referential closure (see id_report) at
# review-feature and review-code for the named plan, and at review-infra and
# review-system for a named runbook or architecture document — identifiers
# only. Whether the ACs are right, whether a TC can admit a wrong
# implementation, and whether a step actually satisfies the TC it cites are
# judgment calls owned by the reviewing skill, not by a parser.
#
# Plan resolution is by explicit path only (see resolve_plan). Governance binds
# to a named artifact: a plan-consuming skill either names its
# docs/plans/<file>.md or blocks asking for it. No slug matching, no session
# pin, no lone-plan adoption — a dormant plan can never capture unrelated work,
# and a gate never fires merely because some plan exists in the repository.
#
# Plan storage and archive rules: skills/dev/plan.md. Gates read the live
# main-tree plan; proof checks use the worktree HEAD (the slice branch).

set -euo pipefail

HOOK_INPUT=$(cat)

# UserPromptSubmit runs this hook on every prompt, so a missing prerequisite
# must only block input that could invoke a dev skill, never ordinary prompts.
if ! command -v jq >/dev/null 2>&1; then
  if [[ "$HOOK_INPUT" == *'"UserPromptSubmit"'* ]]; then
    [[ "$HOOK_INPUT" =~ \"prompt\"[[:space:]]*:[[:space:]]*\"[[:space:]]*/[Dd][Ee][Vv][-:] ]] || exit 0
  else
    [[ "$HOOK_INPUT" == *[Dd][Ee][Vv][-:]* ]] || exit 0
  fi
  printf '{"continue":false,"stopReason":"gate-check requires jq to parse hook input.","decision":"block","reason":"gate-check requires jq to parse hook input."}\n'
  exit 0
fi

DEV_SKILL_SLUG_RE='create-issue|create-pr|design-feature|design-infra|design-system|execute-feature|explore|fix-bug|frame-goal|review-code|review-feature|review-infra|review-system|ship-feature'

is_dev_skill_slug() {
  [[ "$1" =~ ^($DEV_SKILL_SLUG_RE)$ ]]
}

emit_skill_slug() {
  local slug="$1"
  is_dev_skill_slug "$slug" || return 1
  echo "$slug"
}

extract_skill_slug() {
  local raw="${1#/}"
  raw="${raw,,}"
  raw="${raw//_/-}"

  case "$raw" in
    dev:*) emit_skill_slug "${raw#dev:}" && return 0 ;;
    dev-*) emit_skill_slug "${raw#dev-}" && return 0 ;;
  esac

  if [[ "$raw" =~ dev[:-]($DEV_SKILL_SLUG_RE) ]]; then
    emit_skill_slug "${BASH_REMATCH[1]}" && return 0
  fi

  if [[ "$raw" =~ (^|[[:space:]/])($DEV_SKILL_SLUG_RE)([[:space:]]|$) ]]; then
    emit_skill_slug "${BASH_REMATCH[2]}" && return 0
  fi

  echo ""
}

HOOK_EVENT=$(jq -r '.hook_event_name? // ""' <<<"$HOOK_INPUT" 2>/dev/null || true)

if [[ "$HOOK_EVENT" == UserPromptSubmit ]]; then
  # Only a leading slash command invokes a skill. Prose that merely mentions
  # one ("then explore the code", "before create-pr") must never be gated.
  PROMPT=$(jq -r '.prompt? // ""' <<<"$HOOK_INPUT" 2>/dev/null || true)
  [[ "$PROMPT" =~ ^[[:space:]]*/([Dd][Ee][Vv][-:][A-Za-z_-]+)([^A-Za-z0-9_-]|$) ]] || exit 0
  RAW_SKILL="${BASH_REMATCH[1]}"
else
  RAW_SKILL=$(
    jq -r '
      [
        .tool_input.skill?,
        .tool_input.skill_name?,
        .tool_input.name?,
        .tool_input.arguments?,
        .skill?,
        .skill_name?,
        .arguments.skill?,
        # A command field names a skill only as a slash command. Gemini runs
        # this hook for every tool, and a shell command that mentions
        # dev-review-code is not an invocation.
        (.tool_input.command?, .command? | select(type == "string" and test("^\\s*/dev[-:]"; "i")))
      ]
      | map(select(type == "string" and length > 0))
      | .[0] // ""
    ' <<<"$HOOK_INPUT" 2>/dev/null || true
  )
fi
SKILL_SLUG=$(extract_skill_slug "$RAW_SKILL")
[[ -n "$SKILL_SLUG" ]] || exit 0

case "$SKILL_SLUG" in
  # Plan-consuming phases, and the document reviews whose named artifact gets
  # its IDs checked (../skills/dev/ids.md).
  review-feature|execute-feature|review-code|create-pr|ship-feature|review-infra|review-system) ;;
  # Entry-point skills: read-only, or they produce a plan/issue/architecture
  # doc/runbook rather than touching application code. Nothing that mutates
  # application code reaches this branch: plan-backed code changes happen only
  # in gated phases, and direct edits outside a plan are ungated by design
  # (PROCESS.md, Scope). Exiting before root resolution keeps them usable
  # outside a Git repository. Listed rather than left to fall off the slug
  # regex, so the ungated set stays explicit and auditable.
  design-feature|design-system|design-infra|explore|create-issue|fix-bug|frame-goal) exit 0 ;;
  *) exit 0 ;;
esac

# find_explicit_doc canonicalises with realpath -m; without it every named
# path would fail to resolve and report as "no plan named", which hides the real
# cause. Probe the flag, not just the binary — macOS ships a realpath without
# -m, and `command -v` alone would pass it. Probed only for gated skills.
if ! realpath -m -- / >/dev/null 2>&1; then
  printf '{"continue":false,"stopReason":"gate-check requires realpath with -m support (GNU coreutils) to validate plan paths.","decision":"block","reason":"gate-check requires realpath with -m support (GNU coreutils) to validate plan paths."}\n'
  exit 0
fi

STATUS=""
PLAN=""
ACTIVE_WORKTREE=""

block() {
  local reason="$1"
  jq -cn --arg reason "$reason" \
    '{continue:false, stopReason:$reason, decision:"block", reason:$reason}'
  exit 0
}

# Share root resolution with phase skills; never substitute the linked tree.
GATE_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
REPO_ROOT=$(bash "$GATE_DIR/dev-utils.sh" main-root 2>/dev/null) || block "Cannot resolve the main working-tree root. Follow skills/dev/plan.md; do not substitute the current linked worktree."
cd "$REPO_ROOT" || block "Cannot access the main working-tree root: $REPO_ROOT"
# Tree that git history checks run against — repointed to the plan's worktree
# when one is recorded (skills/dev/plan.md#worktree-operations).
GIT_TREE="$REPO_ROOT"

HOOK_TEXT=$(
  jq -r '
    [
      .tool_input.args?,
      .tool_input.arguments?,
      .tool_input.command?,
      .arguments?,
      .command?,
      .prompt?
    ]
    | map(select(type == "string"))
    | join(" ")
  ' <<<"$HOOK_INPUT" 2>/dev/null || true
)

# ── helpers ───────────────────────────────────────────────────────────

# "Exact path" has to mean exact. A bare substring match would accept
# /another/repo/docs/plans/x.md (matching from its own "docs/plans/" and then
# resolving *this* repo's file) and docs/plans/../escape.md, and would pick a
# plan out of surrounding prose. Canonicalise and require a direct child of
# $REPO_ROOT/<dir> (docs/plans, docs/runbooks, or docs/architecture).
#
# Known limit: the hook reads tokens, not intent. A valid plan path *mentioned*
# in free text still resolves ("ship-feature follow up on docs/plans/old.md
# but different" adopts old.md), and when two paths appear the first wins
# silently. Both are the caller's ambiguity to avoid — the skills' contract is
# one named plan per invocation — and a parser cannot tell mention from naming.
find_explicit_doc() {
  local dir="$1" candidate real base re
  re="(^|[[:space:]])([^[:space:]]*${dir}/[^[:space:]]+\\.md)"
  [[ "$HOOK_TEXT" =~ $re ]] || return 1
  candidate="${BASH_REMATCH[2]}"
  real=$(realpath -m -- "$candidate" 2>/dev/null) || return 1
  base=$(realpath -m -- "$REPO_ROOT/$dir" 2>/dev/null) || return 1
  # Direct child only: no nesting, no traversal, no other repository.
  [[ "$real" == "$base/"* && "${real#"$base"/}" != */* ]] || return 1
  [[ -f "$real" ]] || return 1
  # Emit the repo-relative form the rest of the script expects.
  printf '%s\n' "$dir/${real#"$base"/}"
}

find_explicit_plan() {
  find_explicit_doc docs/plans
}

# A bare path was given but resolves to no file (e.g. "docs/plans/x.md" typo).
explicit_path_given_but_missing() {
  local dir="${1:-docs/plans}" re
  re="${dir}/[^[:space:]]+\\.md"
  [[ "$HOOK_TEXT" =~ $re ]] || return 1
  find_explicit_doc "$dir" >/dev/null 2>&1 && return 1
  return 0
}

# Plan resolution is by explicit path, and only by explicit path.
#
# Ambient resolution — unique-slug matching, a session pin, adopting the lone
# active plan — used to make plan-taking skills convenient. It also meant a
# dormant plan sitting in docs/plans/ could capture unrelated work, and that a
# gate fired because a plan existed *somewhere in the repository* rather than
# because this invocation was about that plan. Governance now binds to a named
# artifact: the caller says which plan, or the command blocks asking for one.
resolve_plan() {
  find_explicit_plan 2>/dev/null
}

plan_status() {
  awk '
    /^Status:/ {
      sub(/^Status:[[:space:]]*/, "")
      sub(/[[:space:]]*\|.*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      print
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Type — feature | fix | refactor (lives on the Status line:
# "Status: ... | Type: <type> | Issue:"). Distinct from PR Pattern's single/chain.
plan_type() {
  awk '
    /^Status:/ {
      if (match($0, /Type:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Type:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print tolower(t)
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Issue value (same Status line: "... | Issue: <ref> | Worktree:").
plan_issue() {
  awk '
    /^Status:/ {
      if (match($0, /Issue:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Issue:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print t
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Base branch (same Status line: "... | Base: <branch> | ...").
plan_base() {
  awk '
    /^Status:/ {
      if (match($0, /Base:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Base:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print t
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# Plan header Snapshot commit (same Status line: "... | Snapshot: <sha> | ...").
plan_snapshot() {
  awk '
    /^Status:/ {
      if (match($0, /Snapshot:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Snapshot:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print t
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# True when commit $1 is in the history of any of the given branches. Each
# name is tried as a local branch, as origin's tracking branch (a designer may
# inspect a freshly fetched origin/<base> without updating the local one), and
# as a remote-tracking name already qualified, such as origin/main.
commit_on_any_branch() {
  local commit="$1" branch ref
  shift
  for branch in "$@"; do
    [[ -n "$branch" ]] || continue
    for ref in "refs/heads/$branch" "refs/remotes/origin/$branch" "refs/remotes/$branch"; do
      git -C "$REPO_ROOT" rev-parse --verify -q "$ref^{commit}" >/dev/null 2>&1 || continue
      git -C "$REPO_ROOT" merge-base --is-ancestor "$commit" "$ref" 2>/dev/null && return 0
    done
  done
  return 1
}

# Plan header Worktree path (same Status line: "... | Worktree: <path> | ...").
plan_worktree() {
  awk '
    /^Status:/ {
      if (match($0, /Worktree:[[:space:]]*[^|]+/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^Worktree:[[:space:]]*/, "", t)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
        print t
      }
      exit
    }
  ' "$1" 2>/dev/null
}

# True when the Issue field holds a real issue reference — the skills require
# "#<number>", so anything without one (empty, none, TBD, placeholder) fails.
has_issue() {
  local v
  v=$(plan_issue "$1")
  [[ "$v" =~ ^\#[1-9][0-9]*$ ]]
}

is_registered_worktree() {
  local target="$1" line
  [[ "$target" != "$REPO_ROOT" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == "worktree $target" ]] && return 0
  done < <(git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null)
  return 1
}

# The plan schema has no place for open questions: design-feature resolves
# material ones through its ambiguity gate before drafting, and optional
# follow-ups stay out of the plan. A section or field that parks them is a
# schema violation, whatever it contains — the gate cannot judge whether a
# parked question is material, so it rejects the container.
open_questions_line() {
  awk '
    /^[[:space:]]*(```|~~~)/ { fenced = !fenced; next }
    fenced { next }
    # A heading named for them ("## Assumptions & Open Questions (draft)"),
    # or a field ("Open Questions:", "- **Assumptions**:"). A heading that
    # merely contains the word, such as "### TC-3 — Assumptions API 404", is
    # not a container.
    {
      l = tolower($0)
      if (l ~ /^#+[[:space:]]+(assumptions?|(open )?questions?)([[:space:]]*(&|and)[[:space:]]*(assumptions?|(open )?questions?))?[[:space:]]*(\(.*\))?[[:space:]]*$/ ||
          l ~ /^[[:space:]]*([-*][[:space:]]*)?(\*\*)?(assumptions?|(open )?questions?)(\*\*)?:/) {
        print NR
        exit
      }
    }
  ' "$1" 2>/dev/null
}

# Format and referential closure of an artifact's IDs (../skills/dev/ids.md).
# This reads identifiers, never prose: it proves every ID is well formed,
# declared once, and referenced where the graph requires, never that any edge
# is *true* (whether a Proves: names the right AC, whether a step satisfies the
# TC it cites). That stays the reviewing skill's judgment.
#
# $1 is the artifact kind — plan | runbook | architecture — which selects the
# prefix registry; $2 is the file. Plans additionally get the delivery graph
# (../skills/dev/design-feature.md#id-graph): AC <- TC (Proves:) <- ST
# (satisfies) <- PR (Steps), and FX <- TC.
#
# Three output classes, and the caller must keep them apart. A line prefixed `!`
# means the IDs could not be read at all (old ordinals, ranges, leading zeros,
# duplicates, a missing section, an unparseable Proves:) — a parser that cannot
# read the graph must say so, not report a defect, because a false traceability
# block teaches the reader to distrust the hook. A line prefixed `@` is a plan
# citing another artifact's ID, which plans never do
# (../skills/dev/reference/related-plans.md#order). Everything else is a real
# closure finding.
id_report() {
  awk -v kind="$1" '
    function trim(s) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      return s
    }
    function bad(msg) {
      printf "!%s\n", msg
      unreadable = 1
    }
    # Registry IDs on s, in order, into ids[1..n]. awk has no \b: an ID must
    # not continue a longer word ("UTC-7", "fix-ST-1"), and a #-qualified ID
    # ("docs/plans/x.md#AC-1") belongs to another artifact. Neighbours are read
    # from the whole line, so "TC-2/TC-9" yields both IDs.
    function scan(s,   n, tok, pre, post, off, at) {
      n = 0
      off = 0
      split("", ids)
      while (match(substr(s, off + 1), /[A-Z][A-Z]-[0-9]+/)) {
        at = off + RSTART
        tok = substr(s, at, RLENGTH)
        pre = at > 1 ? substr(s, at - 1, 1) : ""
        post = substr(s, at + RLENGTH, 1)
        off = at + RLENGTH - 1
        if (pre ~ /[A-Za-z0-9_#-]/ || post ~ /[A-Za-z0-9_]/) continue
        if (!(substr(tok, 1, 2) in owner)) continue
        ids[++n] = tok
      }
      return n
    }
    function pfx(id) { return substr(id, 1, 2) }

    BEGIN {
      if (kind == "plan") {
        owner["AC"] = "Acceptance Criteria"; owner["TC"] = "Test Cases"
        owner["FX"] = "Test Fixtures";       owner["ST"] = "Implementation Steps"
        owner["PC"] = "Implementation Steps"; owner["PR"] = "PR Pattern"
        owner["DD"] = "Design Decisions";    owner["RK"] = "Open Risks"
        owner["DS"] = "Discovered Scope";    owner["CG"] = "Coverage Gaps"
      } else if (kind == "runbook") {
        owner["SC"] = "Success Criteria";    owner["CL"] = "Evidence"
        owner["RS"] = "Resources";           owner["PH"] = "Phases"
        owner["OQ"] = "Open Questions";      owner["EX"] = "Execution Record"
      } else {
        owner["SC"] = "Goal and Constraints"; owner["OP"] = "Options"
        owner["CT"] = "Contracts";           owner["PH"] = "Migration"
        owner["DC"] = "Decomposition"
      }
      # Only the runbook Execution Record may mention retired IDs, so only it
      # is exempt from reference checks.
      if (kind == "runbook") history["Execution Record"] = 1
    }

    /^[[:space:]]*(```|~~~)/ { fenced = !fenced; next }
    fenced { next }

    /^## / {
      sec = trim(substr($0, 4))
      sub(/[[:space:]]*\(.*\)$/, "", sec)
      next
    }

    {
      line = $0
      hist = (sec in history)

      # Ordinals are only the old form where the ID now lives; elsewhere
      # "Step 1 of the wizard" is prose.
      if ((sec == "Implementation Steps" || sec == "PR Pattern" || sec == "Phases" || sec == "Migration") &&
          line ~ /^[[:space:]]*([-*#|][-*#|[:space:]]*)?(Step|Phase|Slice)[[:space:]]+[0-9]+/)
        bad(sprintf("line %d uses an ordinal (%s) — write ST-n, PH-n, or PR-n (skills/dev/ids.md)", NR, trim(line)))
      if (kind == "plan" && sec == "PR Pattern" && line ~ /^[[:space:]]*\|[[:space:]]*[0-9]+[[:space:]]*\|/)
        bad(sprintf("PR Pattern row at line %d is numbered — write PR-n in the first column (skills/dev/ids.md)", NR))
      if (kind == "plan" && sec == "Publication Inventory" && line ~ /^[[:space:]]*[0-9]+[[:space:]]*\|/)
        bad(sprintf("Publication Inventory line %d is numbered — write Worktree: PR-n (<branch>) at <path>", NR))
      # An unconverted precondition would otherwise pass silently and leave
      # execute-feature with no PC-n check to run.
      if (kind == "plan" && sec == "Implementation Steps" && line ~ /^[[:space:]]*([-*][[:space:]]*)?Precondition:/)
        bad(sprintf("line %d uses Precondition: — write PC-n — <fact> — Check: <command> (skills/dev/ids.md)", NR))

      # A range collapses IDs the parser must see individually, so it is
      # unreadable input, not an unreferenced ID. Both operands must carry the
      # same prefix (or the second is a bare number), and a dash separator must
      # be unspaced — otherwise "TC-1 - 200 returned" or a title such as
      # "TC-2 — TC-1 variant" would trip it. An Execution Record may quote old ranges.
      if (!hist) {
        for (p in owner) {
          if (line ~ (p "-[0-9]+([[:space:]]+(through|thru|to)[[:space:]]+|[[:space:]]*\\.\\.[[:space:]]*|–|-)" p "-[0-9]+") ||
              line ~ (p "-[0-9]+[[:space:]]+(through|thru|to)[[:space:]]+[0-9]+") ||
              line ~ (p "-[0-9]+(–|-)[0-9]+") ||
              line ~ (p "-[0-9]+[[:space:]]*\\.\\.[[:space:]]*[0-9]+")) {
            bad(sprintf("line %d uses an ID range (%s) — enumerate IDs so traceability can be checked", NR, trim(line)))
            break
          }
        }
      }

      # A plan cites only its own IDs; a fact an earlier plan establishes is
      # restated as a precondition. Any path-like token before #ID counts
      # (be.md#, be#, x.yaml#, `be.md`#); a URL anchor shaped like an ID is an
      # accepted false positive.
      if (kind == "plan" && match(line, /[A-Za-z0-9_\/.`-]#[A-Z][A-Z]-[0-9]+/))
        printf "@line %d cites another artifact\047s ID (%s) — restate the fact as a PC-n precondition\n", NR, trim(line)

      # PR ownership is read from the Steps column only; a Summary that
      # mentions a step does not own it.
      if (kind == "plan" && sec == "PR Pattern" && line ~ /^[[:space:]]*\|/ && line !~ /PR-[0-9]/) {
        nc = split(line, cells, "|")
        for (i = 2; i <= nc; i++) if (trim(cells[i]) == "Steps") stepcol = i
      }

      n = scan(line)
      lead = line
      sub(/^[[:space:]]*([-*|][[:space:]]*|#+[[:space:]]+)?/, "", lead)
      # A line in the owning section that begins with an ID declares it.
      decl = ""
      if (n > 0 && index(lead, ids[1]) == 1 && owner[pfx(ids[1])] == sec) decl = ids[1]

      if (kind == "plan" && sec == "Test Cases") {
        if (decl ~ /^TC-/) {
          curtc = decl; proves[curtc] = ""; provesline[curtc] = 0
        } else if (line ~ /^[^[:space:]]/ && line !~ /^([-*][[:space:]]*)?[A-Za-z][A-Za-z ]*:/) {
          # A new unindented item that is not a TC declaration or one of its
          # fields (Proves:, Fixture:) ends the current TC, so a later Proves:
          # is not attributed to the previous one.
          curtc = ""
        }
        if (line ~ /^[[:space:]]*([-*][[:space:]]*)?Proves:/ && curtc != "") {
          np = 0
          for (i = 1; i <= n; i++) if (pfx(ids[i]) == "AC") { np++; last = ids[i] }
          # Exactly one Proves: per TC, naming exactly one AC. A second line
          # would otherwise overwrite the first and read as well-formed.
          if (provesline[curtc] > 0)
            bad(sprintf("%s has more than one Proves: line (lines %d and %d) — exactly one is required", curtc, provesline[curtc], NR))
          provesline[curtc] = NR
          if (np == 0) bad(sprintf("%s has an unparseable Proves: line (%s)", curtc, trim(line)))
          else if (np > 1) bad(sprintf("%s names %d ACs in Proves: — exactly one is required", curtc, np))
          else proves[curtc] = last
        }
      }

      if (n == 0) next
      for (i = 1; i <= n; i++) {
        if (ids[i] ~ /-0+$/) bad(sprintf("line %d: %s — IDs start at 1", NR, ids[i]))
        else if (ids[i] ~ /-0/) bad(sprintf("line %d: %s has a leading zero — write %s-%d", NR, ids[i], pfx(ids[i]), substr(ids[i], 4) + 0))
      }

      if (decl != "") {
        # A reused ID is two items wearing one name: silently collapsing them
        # drops one from the graph, so it is unreadable input, not an orphan.
        if (decl in declared) bad(sprintf("%s is declared more than once (lines %d and %d) — IDs must be unique", decl, declared[decl], NR))
        else { declared[decl] = NR; order[++nd] = decl; count[pfx(decl)]++ }
      }

      for (i = (decl != "" ? 2 : 1); i <= n; i++)
        if (!hist && !(ids[i] in refline)) { refline[ids[i]] = NR; reforder[++nr] = ids[i] }

      if (kind != "plan") next

      if (sec == "Test Cases")
        for (i = 1; i <= n; i++) if (pfx(ids[i]) == "FX") fxused[ids[i]] = 1

      if (sec == "Implementation Steps") {
        if (decl ~ /^ST-/) { curst = decl; stref[curst] = 0; sttxt[curst] = trim(line) }
        if (curst != "")
          for (i = 1; i <= n; i++) if (pfx(ids[i]) == "TC") { tcnamed[ids[i]] = 1; stref[curst]++ }
      }

      if (sec == "PR Pattern" && decl ~ /^PR-/ && stepcol) {
        split(line, cells, "|")
        m = scan(cells[stepcol])
        for (i = 1; i <= m; i++) if (pfx(ids[i]) == "ST") { stowners[ids[i]]++; stpr[ids[i]] = stpr[ids[i]] " " decl }
      }
    }

    END {
      if (kind == "plan") {
        if (!count["AC"]) bad("no AC- entries under ## Acceptance Criteria")
        if (!count["TC"]) bad("no TC- entries under ## Test Cases")
        if (!count["ST"]) bad("no ST- entries under ## Implementation Steps")
        if (!count["PR"]) bad("no PR- rows under ## PR Pattern")
        else if (!stepcol) bad("## PR Pattern has no Steps column — each PR-n row lists the ST-n steps it owns")
      }
      # Unreadable input cannot produce a trustworthy closure verdict: reporting
      # orphans derived from IDs we failed to parse is the false block above.
      if (unreadable) exit
      for (i = 1; i <= nr; i++) {
        id = reforder[i]
        if (!(id in declared)) printf "line %d cites %s, which is not declared: no line in ## %s begins with it (skills/dev/ids.md)\n", refline[id], id, owner[pfx(id)]
      }
      if (kind != "plan") exit
      for (i = 1; i <= nd; i++) {
        id = order[i]
        if (id ~ /^AC-/) {
          found = 0
          for (t in proves) if (proves[t] == id) found = 1
          if (!found) printf "%s has no TC — no Test Case names it in Proves:\n", id
        } else if (id ~ /^TC-/) {
          if (proves[id] == "") printf "%s has no Proves: line — every TC names exactly one AC\n", id
          if (!(id in tcnamed)) printf "%s is not named by any Implementation Step\n", id
        } else if (id ~ /^FX-/) {
          if (!(id in fxused)) printf "%s is not used by any Test Case\n", id
        } else if (id ~ /^ST-/) {
          if (stref[id] == 0) printf "%s names no TC: %s\n", id, sttxt[id]
          if (stowners[id] == 0) printf "%s is not assigned to any PR row\n", id
          else if (stowners[id] > 1) printf "%s is assigned to more than one PR row:%s\n", id, stpr[id]
        }
      }
    }
  ' "$2" 2>/dev/null
}

# Blocks on any output class, with different messages: an unreadable
# artifact is a shape defect to fix, never a traceability verdict.
require_ids() {
  local kind="$1" file="$2" report
  report=$(id_report "$kind" "$file")
  [[ -n "$report" ]] || return 0
  if [[ "$report" == *$'\n'!* || "$report" == !* ]]; then
    block "$(printf 'gate-check cannot read the IDs in %s — fix them per skills/dev/ids.md and re-run. This is NOT a traceability verdict:\n%s' "$file" "$(sed 's/^[!@]//' <<<"$report")")"
  fi
  if [[ "$report" == *$'\n'@* || "$report" == @* ]]; then
    block "$(printf '%s cites another artifact'"'"'s IDs. A plan cites only its own IDs (skills/dev/reference/related-plans.md#order):\n%s' "$file" "$(sed -n 's/^@//p' <<<"$report")")"
  fi
  if [[ "$kind" == plan ]]; then
    block "$(printf "The ID graph in %s is not closed (skills/dev/design-feature.md#id-graph):\n%s\n\nClosure is shape, not correctness: fixing these does not mean an edge is right." "$file" "$report")"
  fi
  block "$(printf "%s cites IDs it does not declare (skills/dev/ids.md):\n%s" "$file" "$report")"
}

red_commit_count() {
  local base="$1"
  git -C "$GIT_TREE" log --format=%s "${base}..HEAD" 2>/dev/null | grep -Ec '^test\(red\):' || true
}

# Refactor slices prove TDD with a passing "test: baseline <scope>" commit
# instead of a failing test(red): commit.
baseline_commit_count() {
  local base="$1"
  git -C "$GIT_TREE" log --format=%s "${base}..HEAD" 2>/dev/null | grep -Ec '^test:[[:space:]]*baseline' || true
}

proof_sequence_ok() {
  local base="$1" mode="$2" expected="$3" proof_re=""
  case "$mode" in
    red) proof_re='^test\\(red\\):' ;;
    baseline) proof_re='^test:[[:space:]]*baseline' ;;
    *) return 1 ;;
  esac

  git -C "$GIT_TREE" log --format='%s' --reverse "${base}..HEAD" 2>/dev/null | awk \
    -v proof_re="$proof_re" \
    -v expected="$expected" '
      BEGIN { proofs=0; waiting_for_impl=0; seen_proof=0; bad=0 }
      $0 ~ proof_re {
        if (waiting_for_impl) bad=1
        proofs++
        waiting_for_impl=1
        seen_proof=1
        next
      }
      {
        if (!seen_proof) bad=1
        if (waiting_for_impl) waiting_for_impl=0
      }
      END {
        if (proofs < expected || waiting_for_impl || bad) exit 1
      }
    '
}

slice_count() {
  local plan="$1"
  awk '
    /^## PR Pattern/ { in_pattern=1; next }
    /^## / && in_pattern { exit }
    in_pattern && /^\|[[:space:]]*PR-[1-9][0-9]*[[:space:]]*\|/ { count++ }
    END { print count+0 }
  ' "$plan" 2>/dev/null
}

has_final_pr_pattern() {
  local plan="$1"
  grep -q '^## PR Pattern$' "$plan" 2>/dev/null && ! grep -q '^## PR Pattern (provisional)$' "$plan" 2>/dev/null
}

# One line per PR-Pattern row, in table order: that row's Parent, or empty
# when the column or the cell is missing. Callers decide which absence matters.
plan_parents() {
  awk '
    function trim(s) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      return s
    }
    /^## PR Pattern/ { in_pattern=1; next }
    /^## / && in_pattern { exit }
    in_pattern && /^\|/ {
      n=split($0, cells, "|")
      if (trim(cells[2]) ~ /^PR-[1-9][0-9]*$/) {
        print parent_col ? trim(cells[parent_col]) : ""
        next
      }
      for (i=2; i<=n; i++)
        if (trim(cells[i]) == "Parent") parent_col=i
    }
  ' "$1" 2>/dev/null
}

# The integration Base can exclude an unmerged parent. Proof for this plan
# starts at the first slice's explicit Parent, including for a single PR.
plan_first_parent() {
  # awk, not head: head exits early, and the SIGPIPE it can hand back would
  # fail the capturing assignment under set -e and pipefail.
  plan_parents "$1" | awk 'NR==1'
}

# Rows whose Parent is missing. design-feature requires one on every row, and
# create-pr targets each PR at it, so a gap anywhere is a defect.
parentless_row_count() {
  # Piped, not captured: $( ) strips trailing newlines, which would hide a
  # missing parent on the last row — the row most likely to be added late.
  plan_parents "$1" | grep -c '^[[:space:]]*$' || true
}

# ── gate dispatch ─────────────────────────────────────────────────────

# Resolve the named plan only for skills that consume one. Entry skills
# (frame-goal, design-*, explore, create-issue, fix-bug) do not bind to an
# application plan, even if their context mentions one.
case "$SKILL_SLUG" in
  review-feature|execute-feature|review-code|create-pr|ship-feature)
    PLAN=$(resolve_plan 2>/dev/null || true) ;;
  *)
    PLAN="" ;;
esac
# Keep PLAN bound to the root source; only Git checks move into the worktree.
if [[ -n "$PLAN" ]]; then
  # Checked before status and worktree validation: a published record ends
  # delivery whatever it says (plan.md#lifecycle).
  if git -C "$REPO_ROOT" ls-files --error-unmatch -- "$PLAN" >/dev/null 2>&1 ||
     git -C "$REPO_ROOT" cat-file -e "HEAD:$PLAN" 2>/dev/null; then
    block "Plan $PLAN is tracked by Git — a published record; the workflow does not resume it. Restore any local edits to it with git. For follow-up work, start a new plan with design-feature or ship-feature, without the old plan path."
  fi
  STATUS=$(plan_status "$PLAN")
  WT=$(plan_worktree "$PLAN")
  case "${WT,,}" in ""|none|n/a|"<"*">") WT="" ;; esac
  if [[ -n "$WT" ]]; then
    if ! is_registered_worktree "$WT"; then
      block "Plan records 'Worktree: $WT', but that path is not a registered non-main Git worktree. If publication cleanup removed it, rerun dev-publish.sh cleanup $PLAN instead. Otherwise preserve the plan and resolve registration per skills/dev/plan.md#worktree-operations before retrying."
    elif [[ -d "$WT" ]]; then
      GIT_TREE="$WT"
      ACTIVE_WORKTREE="$WT"
    else
      block "Plan records 'Worktree: $WT' but the worktree directory is missing. Preserve the root plan and restore the worktree per skills/dev/plan.md#worktree-operations before continuing."
    fi
  fi
fi

# A plan-consuming skill must name its artifact. The block never inspects how
# many plans exist: "which plan did you mean" is the caller's answer to give,
# and counting them is how a dormant plan used to capture unrelated work.
require_plan() {
  [[ -n "$PLAN" ]] && return 0
  if explicit_path_given_but_missing; then
    block "Named plan not found. Pass an existing docs/plans/<file>.md."
  fi
  block "${SKILL_SLUG} operates on a plan and none was named. Pass its exact path: ${SKILL_SLUG} docs/plans/<file>.md. A slug, a previously used plan, or the only plan in docs/plans/ will not resolve — the path is required. No plan yet → run design-feature first."
}

require_worktree() {
  [[ -n "$ACTIVE_WORKTREE" ]] && return 0
  block "Plan has no active registered Worktree. Run the appropriate execute skill to create it before ${SKILL_SLUG}."
}

case "$SKILL_SLUG" in

  # ── review-feature: plan must be planning ──
  review-feature)
    require_plan
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        planning) ;;
        approved) block "Plan is already approved. Run execute-feature next." ;;
        implemented|reviewed)             block "Plan status is '$STATUS' — too late for review-feature. Continue forward." ;;
        *)                                block "Plan status is '$STATUS' — expected 'planning'. Run design-feature first." ;;
      esac
      OQ_LINE=$(open_questions_line "$PLAN")
      if [[ -n "$OQ_LINE" ]]; then
        block "Plan line $OQ_LINE parks Assumptions or Open Questions, which the plan schema does not have. Resolve material questions through design-feature's ambiguity gate and record the answers in ACs or DD-n entries; keep optional follow-ups out of the plan. Then remove the section and re-run."
      fi
      # design-feature owns issue creation, so the omission surfaces here rather
      # than at execution — after review and approval have already been spent.
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field in the plan header is empty. Link an existing issue (a parent issue may back several plans) or create one (dev-utils.sh issue-create); record it as 'Issue: #<n>', then re-run."
      fi
      require_ids plan "$PLAN"
      # Review verifies the plan against a fixed commit (design-feature 'Stable
      # references'), so later merges into Base cannot keep reopening it. The
      # commit lies on Base, or on PR-1's Parent when the plan extends an
      # unmerged branch. Hex-only also keeps the value from reaching git as an
      # option.
      BASE=$(plan_base "$PLAN")
      [[ -n "$BASE" ]] || block "Plan has no Base branch — the 'Base:' field in the plan header is empty. Set it to the branch this work is based off, then re-run."
      SNAPSHOT=$(plan_snapshot "$PLAN")
      [[ "$SNAPSHOT" =~ ^[0-9a-fA-F]{7,64}$ ]] || block "Plan has no Snapshot commit — the 'Snapshot:' header field must hold the SHA of the commit the design inspected (design-feature 'Stable references'). Record it, then re-run."
      git -C "$REPO_ROOT" cat-file -e "${SNAPSHOT}^{commit}" 2>/dev/null || block "Plan Snapshot '$SNAPSHOT' is not a commit in this repository. Record the inspected commit's SHA, or fetch it, then re-run."
      commit_on_any_branch "$SNAPSHOT" "$BASE" "$(plan_first_parent "$PLAN")" || block "Plan Snapshot '$SNAPSHOT' is not in the history of Base '$BASE' or the first slice's Parent (local or origin). Record a commit from the inspected branch, then re-run."
      # Parents are required here, not at review-code: a gap caught at
      # 'implemented' blocks a plan whose execution is already finished, over a
      # table cell design should have written. PR-1's is review-code's review
      # base; later rows are what create-pr targets each PR at.
      if [[ -n "$(plan_first_parent "$PLAN")" ]]; then
        PARENTLESS=$(parentless_row_count "$PLAN")
        [[ "$PARENTLESS" -eq 0 ]] || block "Plan PR Pattern leaves $PARENTLESS PR row(s) without a Parent. Every PR-n row records its own (design-feature 'PR Pattern'): normally the preceding branch, and for PR-1 the Base branch or the earlier plan's last slice branch (skills/dev/reference/related-plans.md#order)."
      else
        block "Plan PR Pattern has no Parent for PR-1. Give every slice an explicit parent (design-feature 'PR Pattern') — normally the Base branch, or the earlier plan's last slice branch (skills/dev/reference/related-plans.md#order)."
      fi
    fi
    ;;

  # ── execute-feature: plan must be approved (a recorded Worktree means resume) ──
  execute-feature)
    require_plan
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        approved) ;;
        planning) block "Plan status is '$STATUS' — not approved. Run review-feature; only the user sets 'Status: approved'." ;;
        implemented)                      block "Plan is already implemented. Run review-code next." ;;
        reviewed)                         block "Plan status is '$STATUS' — already past execution. Run review-code or create-pr." ;;
        *)                                block "Plan status is '$STATUS' — expected 'approved'." ;;
      esac
      # Every plan (feature/fix/refactor) must be issue-backed before implementation.
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field in the plan header is empty. Link an existing issue (a parent issue may back several plans) or create one (dev-utils.sh issue-create); record it as 'Issue: #<n>', then re-run."
      fi
    fi
    ;;

  # ── review-code: plan must be implemented + RED commit must exist ──
  review-code)
    require_plan
    require_worktree
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        implemented) ;;
        planning|approved)
          block "Plan status is '$STATUS' — not yet implemented. Run the appropriate execute skill first." ;;
        reviewed)      block "Plan is already reviewed. Run create-pr next." ;;
        *)             block "Plan status is '$STATUS' — expected 'implemented'." ;;
      esac
      # Re-review authority and non-convergence belong to independence.md.
      # A header counter is not evidence of readiness or authorization.
      # Catches plans that entered implemented without the normal execution gate.
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field in the plan header is empty. Link an existing issue or create one (dev-utils.sh issue-create), record it as 'Issue: #<n>', then re-run."
      fi
      # Re-checked here, not just at review-feature: execution edits the plan
      # between the two, so a TC that lost its owning step would otherwise
      # never be caught.
      require_ids plan "$PLAN"
    fi
    BASE=$(plan_base "$PLAN")
    [[ -n "$BASE" ]] || block "Plan has no Base branch — the 'Base:' field in the plan header is empty. Set it to the branch this work is based off, then re-run."
    REVIEW_BASE=$(plan_first_parent "$PLAN")
    [[ -n "$REVIEW_BASE" ]] || block "Plan PR Pattern has no first-slice Parent — record the explicit parent before code review."
    git -C "$GIT_TREE" merge-base --is-ancestor "$REVIEW_BASE" HEAD 2>/dev/null || block "Plan PR Pattern Parent '$REVIEW_BASE' is missing or is not an ancestor of the reviewed branch."
    SLICES=$(slice_count "$PLAN")
    [[ "$SLICES" -gt 0 ]] || SLICES=1
    PLAN_TYPE=$(plan_type "$PLAN")
    if [[ "$PLAN_TYPE" == "refactor" ]]; then
      BASELINES=$(baseline_commit_count "$REVIEW_BASE")
      if [[ "$BASELINES" -lt "$SLICES" ]]; then
        block "Found $BASELINES 'test: baseline' commit(s) between $REVIEW_BASE and HEAD; expected at least $SLICES for the plan slice count. Commit the passing baseline before refactor review."
      fi
      if ! proof_sequence_ok "$REVIEW_BASE" baseline "$SLICES"; then
        block "Baseline proof is out of sequence. Each slice must have a 'test: baseline' commit followed by at least one refactor commit before the next slice."
      fi
    else
      REDS=$(red_commit_count "$REVIEW_BASE")
      if [[ "$REDS" -lt "$SLICES" ]]; then
        block "Found $REDS test(red) commit(s) between $REVIEW_BASE and HEAD; expected at least $SLICES for the plan slice count. Run RED phase before code review."
      fi
      if ! proof_sequence_ok "$REVIEW_BASE" red "$SLICES"; then
        block "RED/GREEN proof is out of sequence. Each slice must have a 'test(red)' commit followed by at least one implementation commit before the next slice."
      fi
    fi
    ;;

  # ── create-pr: plan must be reviewed ──
  create-pr)
    require_plan
    require_worktree
    if [[ -n "$PLAN" ]]; then
      case "$STATUS" in
        reviewed) ;;
        implemented)           block "Plan status is 'implemented' — run review-code first." ;;
        planning|approved) block "Plan status is '$STATUS' — not yet executed. Continue the workflow." ;;
        *)                     block "Plan status is '$STATUS' — expected 'reviewed'." ;;
      esac
      if ! has_final_pr_pattern "$PLAN"; then
        block "Plan PR Pattern is missing or still provisional. Run review-code to finalize it before create-pr."
      fi
      if ! has_issue "$PLAN"; then
        block "Plan has no linked issue — the 'Issue:' field must hold '#<n>' before a PR can reference it. Link an existing issue or create one (dev-utils.sh issue-create), record it, then re-run."
      fi
    fi
    ;;

  # ── ship-feature: published records are rejected at plan resolution ──
  ship-feature)
    ;;

  # ── review-infra / review-system: IDs of the named document ──
  # These lanes have no lifecycle gate. A named runbook or architecture
  # document gets its IDs checked; an invocation that names none is not
  # blocked, since the review skill itself asks for the exact path.
  review-infra|review-system)
    if [[ "$SKILL_SLUG" == review-infra ]]; then DOC_DIR=docs/runbooks DOC_KIND=runbook
    else DOC_DIR=docs/architecture DOC_KIND=architecture; fi
    if DOC=$(find_explicit_doc "$DOC_DIR"); then
      require_ids "$DOC_KIND" "$DOC"
    elif explicit_path_given_but_missing "$DOC_DIR"; then
      block "Named document not found. Pass an existing $DOC_DIR/<file>.md."
    fi
    ;;

  *) exit 0 ;;
esac

exit 0
