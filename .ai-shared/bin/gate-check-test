# ── Runbook and architecture IDs ──
write_runbook() {
  mkdir -p "$1/docs/runbooks"
  printf '%s\n' '# Runbook: move workers' 'Status: draft | Date: 2026-10-17 | Issue: #3 | Review:' '' "$2" > "$1/docs/runbooks/move.md"
}
valid_runbook='## Success Criteria
SC-1 — workers healthy on the new pool — Check: kubectl get pods
## Evidence
CL-1 — 3 replicas — kubectl get deploy — 2026-10-17 — verified
## Resources
RS-1 — deploy/worker — move
## Phases
### PH-1 — scale up on the new pool
Verification / gate: SC-1 holds; CL-1 revalidated
### PH-2 — drain the old pool
Prerequisites: PH-1 gate passed
## Open Questions
OQ-1 — drain window — blocks PH-2'

repo=$(new_repo)
write_runbook "$repo" "$valid_runbook"
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/move.md')
assert_pass "$output" 'a well-formed runbook enters review-infra'
output=$(run_gate "$repo" dev-review-infra 'check the drain plan')
assert_pass "$output" 'review-infra without a named runbook is not blocked'
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/missing.md')
assert_block "$output" 'Named document not found' 'a mistyped runbook path blocks'

write_runbook "$repo" "${valid_runbook/PH-1 gate passed/PH-3 gate passed}"
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/move.md')
assert_block "$output" 'cites PH-3, which is not declared: no line in ## Phases' 'a runbook reference to an undeclared phase blocks'

write_runbook "$repo" "${valid_runbook/'### PH-2'/'### Phase 2'}"
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/move.md')
assert_block "$output" 'write ST-n, PH-n, or PR-n' 'an old Phase ordinal in a runbook is unreadable'

mkdir -p "$repo/docs/architecture"
printf '%s\n' '# Events' 'Status: draft' '' '## Goal and Constraints' 'SC-1 — p99 under 200 ms' '## Options' 'OP-1 — queue' 'OP-1 — direct calls' '## Contracts' 'CT-1 — order event' > "$repo/docs/architecture/events.md"
output=$(run_gate "$repo" dev-review-system 'docs/architecture/events.md')
assert_block "$output" 'OP-1 is declared more than once' 'a duplicate architecture option is unreadable'

# ── Missing prerequisites never block ordinary prompts ──
# UserPromptSubmit sees every prompt; only dev-skill input may be blocked.
shim=$(mktemp -d "$TMP_ROOT/shim.XXXXXX")
real_realpath=$(command -v realpath)
printf '#!/bin/bash\n[[ "$1" == -m ]] && exit 1\nexec %q "$@"\n' "$real_realpath" > "$shim/realpath"
chmod +x "$shim/realpath"
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
shim_prompt() {
  jq -cn --arg prompt "$2" '{hook_event_name:"UserPromptSubmit",prompt:$prompt}' | (cd "$repo" && PATH="$1" "$GATE")
}
assert_pass "$(shim_prompt "$shim:$PATH" 'fix the login bug')" 'a realpath without -m does not block a plain prompt'
assert_pass "$(shim_prompt "$shim:$PATH" '/dev-explore auth flow')" 'a realpath without -m does not block an ungated skill'
assert_block "$(shim_prompt "$shim:$PATH" '/dev-review-feature docs/plans/gate.md')" 'realpath with -m support' 'a gated skill still reports the missing realpath -m'
nojq=$(mktemp -d "$TMP_ROOT/nojq.XXXXXX")
ln -s "$(command -v cat)" "$nojq/cat"
assert_pass "$(shim_prompt "$nojq" 'fix the login bug')" 'missing jq does not block a plain prompt'
output=$(jq -cn '{hook_event_name:"UserPromptSubmit",prompt:"/dev-review-feature docs/plans/gate.md"}' | (cd "$repo" && PATH="$nojq" "$GATE"))
assert_block "$output" 'requires jq' 'missing jq still blocks a dev skill'

