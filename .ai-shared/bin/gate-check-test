# ── Runbook and architecture IDs ──
write_runbook() {
  mkdir -p "$1/docs/runbooks"
  printf '%s\n' '# Runbook: move workers' 'Status: draft | Date: 2026-10-17 | Issue: #3 | Review:' '' "$2" > "$1/docs/runbooks/move.md"
}
valid_runbook='## Success Criteria
SC-1 — workers healthy on the new pool — Check: kubectl get pods
## Evidence
CL-1 — 3 replicas — kubectl get deploy — 2026-10-17 — verified
## Resources
RS-1 — deploy/worker — move
## Phases
### PH-1 — scale up on the new pool
Verification / gate: SC-1 holds; CL-1 revalidated
### PH-2 — drain the old pool
Prerequisites: PH-1 gate passed
## Open Questions
OQ-1 — drain window — blocks PH-2'

repo=$(new_repo)
write_runbook "$repo" "$valid_runbook"
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/move.md')
assert_pass "$output" 'a well-formed runbook enters review-infra'
output=$(run_gate "$repo" dev-review-infra 'check the drain plan')
assert_pass "$output" 'review-infra without a named runbook is not blocked'
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/missing.md')
assert_block "$output" 'Named document not found' 'a mistyped runbook path blocks'

write_runbook "$repo" "${valid_runbook/PH-1 gate passed/PH-3 gate passed}"
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/move.md')
assert_block "$output" 'cites PH-3, which is not declared: no line in ## Phases' 'a runbook reference to an undeclared phase blocks'

write_runbook "$repo" "${valid_runbook/'## Resources'/'Contract: docs/architecture/events.md#CT-1
## Resources'}"
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/move.md')
assert_pass "$output" 'a runbook may cite another artifact path-qualified'

write_runbook "$repo" "$valid_runbook"'
## Execution Record
EX-1 — PH-1 ran; PH-3 retired'
output=$(run_gate "$repo" dev-review-infra 'docs/runbooks/move.md')
assert_pass "$output" 'an Execution Record may mention a retired phase'

