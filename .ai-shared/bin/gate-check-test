#!/bin/bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
GATE="$ROOT/bin/gate-check"
TMP_ROOT=$(mktemp -d /tmp/gate-check-test.XXXXXX)
TEST_NO=0

new_repo() {
  local repo
  repo=$(mktemp -d "$TMP_ROOT/repo.XXXXXX")
  git -C "$repo" init -q -b main
  git -C "$repo" config user.email gate-check@example.test
  git -C "$repo" config user.name gate-check-test
  mkdir -p "$repo/docs/plans"
  printf 'seed\n' > "$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -qm seed
  printf '%s\n' "$repo"
}

# A schema-valid plan carries a closed AC/TC/Step graph; gate-check now blocks
# without one, so the default fixture has to be a real plan, not a header stub.
# Pass argument 7 to substitute a broken graph for traceability cases.
#
# Parser fixture, NOT an authoring exemplar — the checker reads only IDs and
# Proves: targets, so everything else here is filler chosen to keep the graph
# closed. For what an AC, TC, or Source should actually look like, see the
# schema in skills/dev/design-feature.md.
valid_graph() {
  cat <<'EOF'
## Acceptance Criteria
AC-1 — the gate blocks an unapproved plan
  Source: user requirement
  Success: execution is refused
  Failure: execution proceeds

## Test Cases
TC-1 — unapproved plan reaches execute-feature
  Proves: AC-1
  Given: a plan at Status: planning
  When: execute-feature is invoked
  Then: the hook blocks

## Implementation Steps
Step 1 — add the status gate — satisfies TC-1
EOF
}

write_plan() {
  local path="$1" status="$2" type="$3" issue="$4" worktree="$5" pattern="$6"
  local graph="${7-$(valid_graph)}"
  local base="${8-main}"
  {
    printf '# Task: gate test\n'
    printf 'Status: %s | Type: %s | Base: %s | Issue: %s | Worktree: %s\n\n' \
      "$status" "$type" "$base" "$issue" "$worktree"
    printf '%s\n\n' "$graph"
    printf '%s\n' "$pattern"
    printf 'Type: single\n'
    printf '| # | Branch | Parent | Steps | Summary |\n'
    printf '|---|--------|--------|-------|---------|\n'
    printf '| 1 | %s/gate-test | %s | 1 | test |\n' "$type" "$base"
  } > "$path"
}

run_gate() {
  local repo="$1" skill="$2" args="$3" session
  TEST_NO=$((TEST_NO + 1))
  session="gate-check-test-$$-$TEST_NO"
  jq -cn --arg session "$session" --arg skill "$skill" --arg args "$args" \
    '{session_id:$session,tool_input:{skill:$skill,arguments:$args}}' |
    (cd "$repo" && "$GATE")
}

# Same-session variant verifies that earlier calls cannot override the
# explicit artifact named by a later call.
run_gate_session() {
  local repo="$1" session="$2" skill="$3" args="$4"
  jq -cn --arg session "$session" --arg skill "$skill" --arg args "$args" \
    '{session_id:$session,tool_input:{skill:$skill,arguments:$args}}' |
    (cd "$repo" && "$GATE")
}

assert_pass() {
  local output="$1" label="$2"
  if [[ -n "$output" ]]; then
    printf 'FAIL: %s\n%s\n' "$label" "$output" >&2
    exit 1
  fi
  printf 'PASS: %s\n' "$label"
}

assert_block() {
  local output="$1" expected="$2" label="$3"
  if ! jq -e --arg expected "$expected" \
    '.decision == "block" and (.reason | contains($expected))' <<<"$output" >/dev/null; then
    printf 'FAIL: %s\n%s\n' "$label" "$output" >&2
    exit 1
  fi
  printf 'PASS: %s\n' "$label"
}

make_registered_plan() {
  local repo="$1" type="$2" status="$3" issue="$4" pattern="$5"
  local graph="${6-$(valid_graph)}"
  local worktree="$repo-worktree"
  git -C "$repo" worktree add -q -b "$type/gate-test" "$worktree" main
  write_plan "$repo/docs/plans/gate.md" "$status" "$type" "$issue" "$worktree" "$pattern" "$graph"
  printf '%s\n' "$worktree"
}

# The infra lane is gone. A stale plan still carrying Type: infra must not
# inherit the old proof exemption — it falls through to the RED-proof gate.
repo=$(new_repo)
make_registered_plan "$repo" infra implemented '#12' '## PR Pattern (provisional)' >/dev/null
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_block "$output" 'Found 0 test(red)' 'retired infra type no longer exempts a plan from RED proof'

repo=$(new_repo)
make_registered_plan "$repo" feature implemented '#12' '## PR Pattern (provisional)' >/dev/null
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_block "$output" 'Found 0 test(red)' 'application review still requires RED proof'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" approved feature '#12abc' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/gate.md')
assert_block "$output" 'no linked issue' 'issue reference must be exactly #<positive-number>'

repo=$(new_repo)
fake_worktree=$(mktemp -d "$TMP_ROOT/unregistered.XXXXXX")
mkdir -p "$fake_worktree/docs/plans"
write_plan "$repo/docs/plans/gate.md" implemented feature '#12' "$fake_worktree" '## PR Pattern (provisional)'
write_plan "$fake_worktree/docs/plans/gate.md" implemented feature '#12' "$fake_worktree" '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_block "$output" 'not a registered non-main Git worktree' 'unregistered worktree is rejected'

# Commit helper for proof-sequencing fixtures: writes files, commits with the
# given subject inside the plan's worktree.
wt_commit() {
  local worktree="$1" subject="$2"; shift 2
  local f
  for f in "$@"; do
    mkdir -p "$worktree/$(dirname "$f")"
    printf 'x\n' >> "$worktree/$f"
  done
  git -C "$worktree" add -A
  git -C "$worktree" commit -qm "$subject"
}

# Code review is uncounted: a header with no counter enters, and a stale plan
# still carrying the retired field is not judged on its value — an exhausted
# 9 would have blocked under the old gate. Explicit re-invocation, not a hook
# limit, is what bounds the cycle (review-code.md `Explicit invocation`).
repo=$(new_repo)
worktree=$(make_registered_plan "$repo" feature implemented '#12' '## PR Pattern (provisional)')
wt_commit "$worktree" 'test(red): gate' tests/gate_test.py
wt_commit "$worktree" 'feat(gate): implement' src/gate.py
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_pass "$output" 'code review enters with no Code Rounds counter in the header'

repo=$(new_repo)
worktree=$(make_registered_plan "$repo" feature implemented '#12' '## PR Pattern (provisional)')
sed -i 's/ | Worktree:/ | Code Rounds: 9 | Worktree:/' "$repo/docs/plans/gate.md"
wt_commit "$worktree" 'test(red): gate' tests/gate_test.py
wt_commit "$worktree" 'feat(gate): implement' src/gate.py
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_pass "$output" 'an exhausted retired Code Rounds counter no longer gates code review'

# Any commit before RED blocks — plan files are never committed.
repo=$(new_repo)
worktree=$(make_registered_plan "$repo" feature implemented '#12' '## PR Pattern (provisional)')
wt_commit "$worktree" 'chore: setup' src/gate.py
wt_commit "$worktree" 'test(red): gate' tests/gate_test.py
wt_commit "$worktree" 'feat(gate): implement' src/gate.py
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_block "$output" 'out of sequence' 'any commit before RED blocks sequencing'

repo=$(new_repo)
make_registered_plan "$repo" feature reviewed '#12' '## PR Pattern' >/dev/null
output=$(run_gate "$repo" dev-create-pr 'docs/plans/gate.md')
assert_pass "$output" 'reviewed plan permits create-pr'

repo=$(new_repo)
output=$(run_gate "$repo" dev-fix-bug 'broken behavior')
assert_pass "$output" 'a plain symptom enters diagnosis without a mode or plan'
output=$(run_gate "$repo" dev-fix-bug 'please diagnose and then fix the crash')
assert_pass "$output" 'a requested fix enters diagnosis and routing'
output=$(run_gate "$repo" dev-fix-bug 'execute fails when the queue is empty')
assert_pass "$output" 'symptom wording is not parsed as an execution mode'
output=$(run_gate "$repo" dev-execute-feature '')
assert_block "$output" 'none was named' 'implementation still requires an explicit plan'
write_plan "$repo/docs/plans/gate.md" planning fix '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/gate.md')
assert_block "$output" 'not approved' 'diagnostic entry does not approve implementation'

repo=$(new_repo)
fake_worktree=$(mktemp -d "$TMP_ROOT/diagnose-stale.XXXXXX")
write_plan "$repo/docs/plans/gate.md" approved fix '#12' "$fake_worktree" '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-fix-bug 'broken behavior mentioned in docs/plans/gate.md')
assert_pass "$output" 'diagnosis ignores stale execution state even when a plan is mentioned'

# 'reviewed' is the sole entry status for create-pr; an unreviewed plan must
# not reach a PR.
repo=$(new_repo)
make_registered_plan "$repo" feature implemented '#12' '## PR Pattern' >/dev/null
output=$(run_gate "$repo" dev-create-pr 'docs/plans/gate.md')
assert_block "$output" 'run review-code first' 'implemented plan cannot skip review-code and open a PR'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/gate.md')
assert_pass "$output" 'approved plan with issue executes'

# 'abandoned' is terminal: it is not an entry status for any skill. With
# ambient resolution gone this is the whole of its mechanical meaning — the
# pin it used to release no longer exists.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" abandoned feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/gate.md')
assert_block "$output" 'abandoned' 'abandoned plan cannot be executed'

# A terminal plan beside an active one is inert: naming the active plan works
# regardless of what else sits in docs/plans/.
repo=$(new_repo)
write_plan "$repo/docs/plans/dropped.md" abandoned feature '#12' '' '## PR Pattern (provisional)'
write_plan "$repo/docs/plans/shipped.md" archived feature '#12' '' '## PR Pattern (provisional)'
write_plan "$repo/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/gate.md')
assert_pass "$output" 'terminal plans beside an explicitly named active plan are inert'

# ── explicit plan resolution ──
# Governance binds to a named artifact: a dormant plan must never capture
# unrelated work, and a gate must never fire because a plan merely exists.

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature '')
assert_block "$output" 'none was named' 'a lone active plan is not adopted without an explicit path'

repo=$(new_repo)
write_plan "$repo/docs/plans/alpha.md" approved feature '#12' '' '## PR Pattern (provisional)'
write_plan "$repo/docs/plans/beta.md" planning feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/alpha.md')
assert_pass "$output" 'an exact path selects among several active plans'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/beta.md')
assert_pass "$output" 'the sibling plan resolves independently by its own path'

repo=$(new_repo)
write_plan "$repo/docs/plans/jwt-auth.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'jwt-auth')
assert_block "$output" 'none was named' 'a unique slug without a path no longer resolves'

# No pin: two calls in one session both require the path.
repo=$(new_repo)
session="gate-check-test-$$-no-pin"
write_plan "$repo/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate_session "$repo" "$session" dev-execute-feature 'docs/plans/gate.md')
assert_pass "$output" 'an explicitly named plan resolves'
output=$(run_gate_session "$repo" "$session" dev-execute-feature '')
assert_block "$output" 'none was named' 'a prior explicit call does not pin the session for the next'

# ship-feature <requirement> starts a new design and must not adopt a dormant
# plan — otherwise unrelated work inherits that plan's gates.
repo=$(new_repo)
write_plan "$repo/docs/plans/dormant.md" implemented feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-ship-feature 'add rate limiting to the upload endpoint')
assert_pass "$output" 'ship-feature with a requirement ignores a dormant plan'

# frame-goal is an entry skill: it frames goals before any plan exists, so
# it is ungated and adopts nothing.
output=$(run_gate "$repo" dev-frame-goal 'add rate limiting to the upload endpoint')
assert_pass "$output" 'frame-goal is ungated beside a dormant plan'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" archived feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-ship-feature 'docs/plans/gate.md from execute')
assert_block "$output" 'already shipped' 'ship-feature resume names its plan and still sees terminal status'

# Diagnosis never adopts an application plan; implementation names its own.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-fix-bug 'uploads return 502 under load')
assert_pass "$output" 'diagnose remains planless beside an active plan'
output=$(run_gate "$repo" dev-execute-feature '')
assert_block "$output" 'none was named' 'implementation cannot adopt the lone active plan'

# ── AC <-> TC <-> Step referential closure ──
# The hook reads identifiers, never prose. Closure proves every ID is
# referenced; whether an edge is *true* stays review-feature's judgment.

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'closed AC/TC/Step graph enters review-feature'

# ── Plan size does not replace traceability or requirement checks ──

# A closed graph of exactly $1 ACs, one TC and one step each.
graph_with_acs() {
  awk -v n="$1" 'BEGIN {
    print "## Acceptance Criteria"
    for (i = 1; i <= n; i++) {
      printf "AC-%d — outcome %d\n  Source: user requirement\n  Success: it holds\n  Failure: it does not\n", i, i
    }
    print ""
    print "## Test Cases"
    for (i = 1; i <= n; i++) printf "TC-%d — scenario %d\n  Proves: AC-%d\n", i, i, i
    print ""
    print "## Implementation Steps"
    for (i = 1; i <= n; i++) printf "Step %d — do %d — satisfies TC-%d\n", i, i, i
  }'
}

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' "$(graph_with_acs 7)"
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'seven ACs enter review-feature'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' "$(graph_with_acs 8)"
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'eight coherent ACs enter review without an arbitrary cap'

# Larger plans still need resolved requirements.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' "$(graph_with_acs 8)"
printf '\n## Assumptions & Open Questions\nOpen Questions: which store owns the balance?\n' >> "$repo/docs/plans/gate.md"
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'unresolved Open Question' 'larger plans still block unresolved requirements'

# Size does not block implemented work with valid proof.
repo=$(new_repo)
worktree=$(make_registered_plan "$repo" feature implemented '#12' '## PR Pattern (provisional)' "$(graph_with_acs 8)")
wt_commit "$worktree" 'test(red): gate' tests/gate_test.py
wt_commit "$worktree" 'feat(gate): implement' src/gate.py
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_pass "$output" 'larger plans with proof enter code review'

# No review carries a round counter: a plan with no counter enters, and a stale
# plan still holding an exhausted one is not judged on its value.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'feature review enters with no Rounds counter in the header'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
sed -i 's/ | Worktree:/ | Rounds: 7 | Worktree:/' "$repo/docs/plans/gate.md"
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'an exhausted retired Rounds counter no longer gates feature review'

# design-feature owns issue creation, so a missing issue must surface at review
# entry — not at execution, after review and approval have been spent.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'no linked issue' 'review-feature requires the issue before review'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
  Source: goal
AC-2 — second outcome
  Source: approval.md
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'AC-2 has no TC' 'an AC no TC proves is an unreferenced ID'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
  Source: goal
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — second scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'TC-2 is not named by any Implementation Step' 'a TC no step names is an unreferenced ID'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
  Source: goal
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1
Step 2 — unrelated cleanup'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'names no TC' 'a step citing no TC is an unreferenced ID'

# Unreadable input must not be reported as a traceability defect: a false
# closure block teaches the reader to distrust the hook.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1 through TC-4'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'cannot read' 'an ID range is unreadable input, not an unreferenced ID'
assert_block "$output" 'uses an ID range' 'the range block names the offending line'

# "TC-1 to TC-4" is the same range: without the "to" separator the middle IDs
# would decay into unreferenced-ID findings — a false closure verdict.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — scenario
  Proves: AC-1
TC-3 — scenario
  Proves: AC-1
TC-4 — scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1 to TC-4'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'uses an ID range' 'a "to" range between two IDs is unreadable input, not orphaned middle IDs'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: the login AC
## Implementation Steps
Step 1 — action — satisfies TC-1'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'unparseable Proves:' 'a Proves: naming no AC ID is unreadable input'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1, AC-2
## Implementation Steps
Step 1 — action — satisfies TC-1'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'exactly one is required' 'a TC proving two ACs is unreadable input'

# Bulleted entries are the same graph: the step matcher already tolerated a
# leading bullet, so AC/TC/Proves must too or a bulleted plan blocks as
# "unreadable" over pure formatting.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
- AC-1 — outcome
  - Source: goal
## Test Cases
- TC-1 — scenario
  - Proves: AC-1
## Implementation Steps
- Step 1 — action — satisfies TC-1'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'a bulleted plan resolves the same graph'

# Malformed graphs the parser must not accept as closed. Each contradicts the
# advertised guarantee (unique IDs, exactly one Proves: per TC naming a
# declared AC, every step citing declared TCs).
bad_graph() {
  local label="$1" graph="$2" expected="$3"
  local r
  r=$(new_repo)
  write_plan "$r/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' "$graph"
  assert_block "$(run_gate "$r" dev-review-feature 'docs/plans/gate.md')" "$expected" "$label"
}

bad_graph 'a duplicate AC ID is unreadable input' '## Acceptance Criteria
AC-1 — outcome
AC-1 — a different outcome wearing the same ID
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1' 'declared more than once'

bad_graph 'a duplicate TC ID is unreadable input' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-1 — another scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1' 'declared more than once'

# Steps are keyed by occurrence, but their numbers are IDs the plan cites —
# a reused number is two steps wearing one name, same as a duplicate AC/TC.
bad_graph 'a duplicate Step number is unreadable input' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — second scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1
Step 1 — a different action wearing the same number — satisfies TC-2' 'declared more than once'

bad_graph 'two Proves: lines on one TC are unreadable input' '## Acceptance Criteria
AC-1 — outcome
AC-2 — second outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
  Proves: AC-2
## Implementation Steps
Step 1 — action — satisfies TC-1' 'more than one Proves:'

# A TC with no Proves: at all used to slip through whenever another TC already
# covered the AC and a step named the malformed one.
bad_graph 'a TC with no Proves: line at all is reported' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — scenario with no Proves line
  Given: setup
## Implementation Steps
Step 1 — action — satisfies TC-1 and TC-2' 'TC-2 has no Proves: line'

bad_graph 'a step citing an undeclared TC is reported' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1
Step 2 — action — satisfies TC-99' 'TC-99, which is not declared'

# ── plan path must be exact ──
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature '/some/other/repo/docs/plans/gate.md')
assert_block "$output" 'not found' 'a path in another repository does not resolve this repo'"'"'s plan'

mkdir -p "$repo/docs/other"
write_plan "$repo/docs/other/escape.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/../other/escape.md')
assert_block "$output" 'not found' 'traversal out of docs/plans does not resolve'

mkdir -p "$repo/docs/plans/nested"
write_plan "$repo/docs/plans/nested/deep.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(run_gate "$repo" dev-execute-feature 'docs/plans/nested/deep.md')
assert_block "$output" 'not found' 'a nested plan path is not a direct child of docs/plans'

# The intent-line plan shape (design-feature): "## Test Cases (intent)" header
# and a Test: back-fill line must parse as the same graph.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
  Source: goal
## Test Cases (intent)
TC-1 — scenario intent
  Proves: AC-1
  Test: tests/refund_test.py::test_over_balance_rejected
## Implementation Steps
Step 1 — action — satisfies TC-1'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'an intent-line plan with a Test: field resolves the same graph'

# "TC-1 — 200 returned" must not trip the range detector.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — the endpoint returns 200 on success
  Source: contract
## Test Cases
TC-1 — 200 returned for a valid request
  Proves: AC-1
## Implementation Steps
Step 1 — add the handler — satisfies TC-1'
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'a numeric em-dash summary is not read as an ID range'

# The graph is re-checked at review-code: the plan is edited during execution,
# so a TC added mid-flight with no owning step is caught there or nowhere.
repo=$(new_repo)
make_registered_plan "$repo" feature implemented '#12' '## PR Pattern (provisional)' '## Acceptance Criteria
AC-1 — outcome
  Source: goal
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — added during execution
  Proves: AC-1
## Implementation Steps
Step 1 — action — satisfies TC-1' >/dev/null
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_block "$output" 'TC-2 is not named by any Implementation Step' 'review-code re-checks closure after execution edits'

# Row 1's Parent is required at plan review, not after execution has finished.
repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
sed -i 's/| 1 | feature\/gate-test | main |/| 1 | feature\/gate-test | |/' "$repo/docs/plans/gate.md"
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'no Parent for row 1' 'plan review requires an explicit parent for the first slice'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
printf '| 2 | feature/gate-test-2 | | 2 | second |\n' >> "$repo/docs/plans/gate.md"
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_block "$output" 'without a Parent' 'a later chain row may not omit its parent either'

# A follow-up proves only its own work; the unmerged parent's history is outside
# the current plan, including when that parent has no test(red) commit.
repo=$(new_repo)
git -C "$repo" checkout -qb feat/parent
printf 'parent\n' > "$repo/parent.txt"
git -C "$repo" add parent.txt
git -C "$repo" commit -qm 'feat: existing parent work'
git -C "$repo" checkout -q main
worktree=$(make_registered_plan "$repo" fix implemented '#12' '## PR Pattern (provisional)')
git -C "$worktree" merge -q --ff-only feat/parent
sed -i 's/| fix\/gate-test | main |/| fix\/gate-test | feat\/parent |/' "$repo/docs/plans/gate.md"
git -C "$worktree" commit --allow-empty -qm 'test(red): regression'
git -C "$worktree" commit --allow-empty -qm 'fix: regression'
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_pass "$output" 'follow-up proof starts at its recorded parent instead of the integration base'
sed -i 's/| fix\/gate-test | feat\/parent |/| fix\/gate-test | |/' "$repo/docs/plans/gate.md"
output=$(run_gate "$repo" dev-review-code 'docs/plans/gate.md')
assert_block "$output" 'Parent' 'review does not silently default when the first slice parent is missing'

# Phase entry reads only the root plan, even from inside the worktree.
repo=$(new_repo)
worktree=$(make_registered_plan "$repo" feature reviewed '#12' '## PR Pattern')
output=$(run_gate "$repo" dev-create-pr 'docs/plans/gate.md')
assert_pass "$output" 'publication requires no plan file in the worktree'
output=$(run_gate "$worktree" dev-create-pr 'docs/plans/gate.md')
assert_pass "$output" 'relative plan paths resolve to the root from a worktree'
output=$(run_gate "$worktree" dev-create-pr "$repo/docs/plans/gate.md")
assert_pass "$output" 'absolute root plan paths resolve from a worktree'

# Only the root plan controls phase entry; other copies are ignored.
mkdir -p "$worktree/docs/plans"
cp "$repo/docs/plans/gate.md" "$worktree/docs/plans/gate.md"
sed -i 's/Status: reviewed/Status: implemented/' "$repo/docs/plans/gate.md"
output=$(run_gate "$repo" dev-create-pr 'docs/plans/gate.md')
assert_block "$output" 'run review-code first' 'a stale reviewed worktree copy cannot override the root status'
output=$(run_gate "$worktree" dev-create-pr 'docs/plans/gate.md')
assert_block "$output" 'run review-code first' 'worktree invocation also uses the changed root status without syncing'
sed -i 's/Status: implemented/Status: reviewed/' "$repo/docs/plans/gate.md"
printf '\nWorktree-only note\n' >> "$worktree/docs/plans/gate.md"
output=$(run_gate "$repo" dev-create-pr 'docs/plans/gate.md')
assert_pass "$output" 'a differing worktree copy does not impose a sync gate'
output=$(run_gate "$worktree" dev-create-pr "$worktree/docs/plans/gate.md")
assert_block "$output" 'not found' 'absolute worktree plan paths are not accepted as root artifacts'
mv "$repo/docs/plans/gate.md" "$repo/docs/plans/gate.saved"
output=$(run_gate "$worktree" dev-create-pr 'docs/plans/gate.md')
assert_block "$output" 'not found' 'a worktree copy cannot replace a missing root plan'

# Linked-worktree review must read root metadata and use worktree proof history.
repo=$(new_repo)
worktree=$(make_registered_plan "$repo" feature implemented '#12' '## PR Pattern (provisional)')
wt_commit "$worktree" 'test(red): gate' tests/gate_test.py
wt_commit "$worktree" 'feat(gate): implement' src/gate.py
output=$(run_gate "$worktree" dev-review-code 'docs/plans/gate.md')
assert_pass "$output" 'linked-worktree review combines the root plan with worktree proof commits'

# Failed root discovery must not fall back to a plan in the current tree.
mkdir -p "$worktree/docs/plans"
write_plan "$worktree/docs/plans/gate.md" approved feature '#12' '' '## PR Pattern (provisional)'
output=$(
  git() {
    if [[ "${1:-}" == worktree && "${2:-}" == list ]]; then return 1; fi
    command git "$@"
  }
  export -f git
  run_gate "$worktree" dev-execute-feature 'docs/plans/gate.md'
)
assert_block "$output" 'main working-tree root' 'failed root discovery cannot adopt a linked-worktree plan'

printf 'All gate-check tests passed. Temporary fixtures: %s\n' "$TMP_ROOT"
