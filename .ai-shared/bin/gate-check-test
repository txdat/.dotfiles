#!/bin/bash
# gate-check against scratch repositories: block and pass cases for each gate.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
GATE="$ROOT/bin/gate-check"
TMP_ROOT=$(mktemp -d /tmp/gate-check-test.XXXXXX)
P=docs/plans/12_feature_gate.spec.md

new_repo() {
  local repo
  repo=$(mktemp -d "$TMP_ROOT/repo.XXXXXX")
  git -C "$repo" init -q -b main
  git -C "$repo" config user.email gate-check@example.test
  git -C "$repo" config user.name gate-check-test
  mkdir -p "$repo/docs/plans"
  printf 'seed\n' > "$repo/README.md"
  git -C "$repo" add README.md
  git -C "$repo" commit -qm seed
  printf '%s\n' "$repo"
}

# Parser fixture, not an authoring exemplar: the gate reads only IDs and
# fields, so the prose is filler that keeps the graph closed.
valid_graph() {
  cat <<'EOF'
## Acceptance Criteria
AC-1 — the gate blocks an unapproved plan
  Source: user requirement
  Success: execution is refused
  Failure: execution proceeds

## Test Cases
TC-1 — unapproved plan reaches execute-feature
  Proves: AC-1
  Fixture: a plan at Status: planning
  Action: execute-feature is invoked
  Expected: the hook blocks

## Implementation Steps
ST-1 — add the status gate — satisfies TC-1
EOF
}

# write_plan <file> <status> [worktree] [graph] [type] [issue] [extra header line]
# One PR row, feat/gate on main, owns every declared step.
write_plan() {
  local file="$1" status="$2" wt="${3-}" graph="${4-$(valid_graph)}" type="${5-feature}" issue="${6-#12}" extra="${7-}" steps
  steps=$(grep -oE '^[-* ]*ST-[0-9]+' <<<"$graph" | grep -oE 'ST-[0-9]+' | paste -sd, - | sed 's/,/, /g' || true)
  mkdir -p "$(dirname "$file")"
  {
    printf '# Gate test\n'
    printf 'Status: %s | Type: %s | Base: main | Issue: %s | Worktree: %s\n' "$status" "$type" "$issue" "$wt"
    if [[ -n "$extra" ]]; then printf '%s\n' "$extra"; fi
    printf '\n## Goal\nGate the phases.\n\n%s\n\n' "$graph"
    printf '## PR Pattern\n| PR | Branch | Parent | Steps | Summary |\n|---|---|---|---|---|\n'
    printf '| PR-1 | feat/gate | main | %s | test |\n' "${steps:-ST-1}"
  } > "$file"
}

# A registered worktree on feat/gate with the plan recorded in the root.
plan_with_worktree() {
  local repo="$1" status="$2" wt="$1-wt"
  git -C "$repo" worktree add -q -b feat/gate "$wt" main
  write_plan "$repo/$P" "$status" "$wt" "${3-$(valid_graph)}" "${4-feature}"
  printf '%s\n' "$wt"
}

wt_commit() {
  local wt="$1" subject="$2" f; shift 2
  for f in "$@"; do mkdir -p "$wt/$(dirname "$f")"; printf 'x\n' >> "$wt/$f"; done
  git -C "$wt" add -A
  git -C "$wt" commit -qm "$subject"
}

commit_plan() { git -C "$1" add -f "$2" && git -C "$1" commit -qm "docs(plan): archive"; }

run_gate() {
  jq -cn --arg skill "$2" --arg args "$3" '{tool_input:{skill:$skill,args:$args}}' | (cd "$1" && "$GATE")
}
prompt_gate() {
  jq -cn --arg prompt "$2" '{hook_event_name:"UserPromptSubmit",prompt:$prompt}' | (cd "$1" && "$GATE")
}

assert_pass() {
  [[ -z "$1" ]] || { printf 'FAIL: %s\n%s\n' "$2" "$1" >&2; exit 1; }
  printf 'PASS: %s\n' "$2"
}
assert_block() {
  jq -e --arg e "$2" '.decision == "block" and (.reason | contains($e))' <<<"$1" >/dev/null 2>&1 ||
    { printf 'FAIL: %s\n%s\n' "$3" "$1" >&2; exit 1; }
  printf 'PASS: %s\n' "$3"
}

# A planning plan with graph $2 at review-feature: assert $3 is in the block,
# or a pass when $3 is empty.
review_graph() {
  local label="$1" graph="$2" expected="$3" r
  r=$(new_repo)
  write_plan "$r/$P" planning '' "$graph"
  if [[ -n "$expected" ]]; then assert_block "$(run_gate "$r" dev-review-feature "$P")" "$expected" "$label"
  else assert_pass "$(run_gate "$r" dev-review-feature "$P")" "$label"; fi
}

# A closed graph of $1 ACs, one TC and one step each.
graph_n() {
  awk -v n="$1" 'BEGIN {
    print "## Acceptance Criteria"; for (i = 1; i <= n; i++) printf "AC-%d — outcome %d\n", i, i
    print "## Test Cases"; for (i = 1; i <= n; i++) printf "TC-%d — scenario %d\n  Proves: AC-%d\n", i, i, i
    print "## Implementation Steps"; for (i = 1; i <= n; i++) printf "ST-%d — do %d — satisfies TC-%d\n", i, i, i
  }'
}

# ── plan resolution ──
repo=$(new_repo)
write_plan "$repo/$P" approved
assert_block "$(run_gate "$repo" dev-execute-feature '')" 'none was named' 'a lone plan is not adopted without a path'
assert_block "$(run_gate "$repo" dev-execute-feature 'gate')" 'none was named' 'a slug does not resolve'
assert_pass "$(run_gate "$repo" dev-execute-feature "$P")" 'an exact path resolves'
assert_pass "$(run_gate "$repo" dev-execute-feature "@$P, please")" 'surrounding punctuation is not part of the path'
assert_block "$(run_gate "$repo" dev-execute-feature "/other/repo/$P")" 'not found' 'a path in another repository does not resolve'
mkdir -p "$repo/docs/other" "$repo/docs/plans/nested"
write_plan "$repo/docs/other/0_feature_x.spec.md" approved
write_plan "$repo/docs/plans/nested/0_feature_x.spec.md" approved
assert_block "$(run_gate "$repo" dev-execute-feature 'docs/plans/../other/0_feature_x.spec.md')" 'not found' 'traversal out of docs/plans does not resolve'
assert_block "$(run_gate "$repo" dev-execute-feature 'docs/plans/nested/0_feature_x.spec.md')" 'not found' 'a nested path does not resolve'
assert_block "$(run_gate "$repo" dev-execute-feature 'docs/plans/12_feature_typo.spec.md')" 'not found: docs/plans/12_feature_typo.spec.md' 'a mistyped path blocks'
write_plan "$repo/docs/plans/12_feature_other.spec.md" approved
assert_block "$(run_gate "$repo" dev-execute-feature "$P docs/plans/12_feature_other.spec.md")" 'takes one plan path' 'two plans block'
write_plan "$repo/docs/plans/gate.md" approved
assert_block "$(run_gate "$repo" dev-execute-feature 'docs/plans/gate.md')" 'none was named' 'a .md plan without .spec is not a plan path'
write_plan "$repo/docs/plans/gate.spec.md" approved
assert_block "$(run_gate "$repo" dev-execute-feature 'docs/plans/gate.spec.md')" 'does not match docs/plans/<issue>_<type>_<slug>.spec.md' 'a plan name outside the format blocks'

repo=$(new_repo)
write_plan "$repo/$P" approved
commit_plan "$repo" "$P"
assert_block "$(run_gate "$repo" dev-execute-feature "$P")" 'published record' 'a tracked plan is a published record'
printf '\nedited\n' >> "$repo/$P"
assert_block "$(run_gate "$repo" dev-execute-feature "$P")" 'published record' 'local edits do not make a tracked plan live'
git -C "$repo" rm -q --cached "$P"
assert_block "$(run_gate "$repo" dev-execute-feature "$P")" 'published record' 'a plan in HEAD but not the index is published'

repo=$(new_repo)
write_plan "$repo/docs/plans/12_feature_shipped.spec.md" reviewed
commit_plan "$repo" docs/plans/12_feature_shipped.spec.md
write_plan "$repo/$P" approved
assert_pass "$(run_gate "$repo" dev-execute-feature "$P")" 'a published plan beside the named live plan is inert'

# ── hook input shapes ──
repo=$(new_repo)
write_plan "$repo/$P" approved
out=$(jq -cn --arg a "$P" '{hook_event_name:"PreToolUse",tool_name:"Skill",tool_input:{skill:"dev-review-feature",arguments:$a}}' | (cd "$repo" && "$GATE"))
assert_block "$out" 'already approved' 'the Pi arguments shape resolves the plan'
assert_block "$(prompt_gate "$repo" "/dev-review-feature $P")" 'already approved' 'a typed /dev-review-feature is gated'
assert_block "$(prompt_gate "$repo" "/dev-review-feature, $P")" 'already approved' 'punctuation after a typed skill still gates it'
assert_block "$(prompt_gate "$repo" "/Dev-review-feature $P")" 'already approved' 'a typed skill is gated regardless of case'
assert_block "$(prompt_gate "$repo" '/dev-execute-feature')" 'none was named' 'a typed phase without a path blocks'
assert_pass "$(prompt_gate "$repo" "please review-feature $P later")" 'prose that mentions a skill is not gated'
assert_pass "$(prompt_gate "$repo" 'explain /dev-review-feature to me')" 'a slash command not at the start is not gated'
out=$(jq -cn '{hook_event_name:"PreToolUse",tool_name:"run_shell_command",tool_input:{command:"git commit -m \"dev-review-code notes\""}}' | (cd "$repo" && "$GATE"))
assert_pass "$out" 'a shell command that mentions a dev skill is not an invocation'
out=$(jq -cn --arg c "/dev-review-feature $P" '{hook_event_name:"PreToolUse",tool_name:"SlashCommand",tool_input:{command:$c}}' | (cd "$repo" && "$GATE"))
assert_block "$out" 'already approved' 'a slash command in a command field is gated'
nogit=$(mktemp -d "$TMP_ROOT/nogit.XXXXXX")
assert_pass "$(prompt_gate "$nogit" '/dev-explore where is auth handled')" 'an ungated skill runs outside a Git repository'
assert_pass "$(run_gate "$repo" dev-fix-bug "crash mentioned in $P")" 'fix-bug is ungated even when it mentions a plan'

shim=$(mktemp -d "$TMP_ROOT/shim.XXXXXX")
printf '#!/bin/bash\n[[ "$1" == -m ]] && exit 1\nexec %q "$@"\n' "$(command -v realpath)" > "$shim/realpath"
chmod +x "$shim/realpath"
shim_prompt() { jq -cn --arg p "$2" '{hook_event_name:"UserPromptSubmit",prompt:$p}' | (cd "$repo" && PATH="$1" "$GATE"); }
assert_pass "$(shim_prompt "$shim:$PATH" 'fix the login bug')" 'a realpath without -m does not block a plain prompt'
assert_pass "$(shim_prompt "$shim:$PATH" '/dev-explore auth flow')" 'a realpath without -m does not block an ungated skill'
assert_block "$(shim_prompt "$shim:$PATH" "/dev-review-feature $P")" 'realpath with -m support' 'a gated skill reports the missing realpath -m'
nojq=$(mktemp -d "$TMP_ROOT/nojq.XXXXXX")
ln -s "$(command -v cat)" "$nojq/cat"
assert_pass "$(shim_prompt "$nojq" 'fix the login bug')" 'missing jq does not block a plain prompt'
assert_pass "$(shim_prompt "$nojq" 'restart the dev-server')" 'missing jq does not block a prompt that mentions dev-'
out=$(jq -cn --arg p "/dev-review-feature $P" '{hook_event_name:"UserPromptSubmit",prompt:$p}' | (cd "$repo" && PATH="$nojq" "$GATE"))
assert_block "$out" 'requires jq' 'missing jq still blocks a dev skill'

# ── worktree and root ──
repo=$(new_repo)
fake=$(mktemp -d "$TMP_ROOT/unregistered.XXXXXX")
write_plan "$repo/$P" implemented "$fake"
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'stop and report it' 'an unregistered worktree stops the phase'
write_plan "$repo/$P" reviewed "$repo-removed"
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "rerun dev-publish.sh cleanup $P" 'a worktree cleanup removed points to cleanup'

repo=$(new_repo)
wt=$(plan_with_worktree "$repo" reviewed)
assert_pass "$(run_gate "$repo" dev-create-pr "$P")" 'a reviewed plan with a worktree enters create-pr'
assert_pass "$(run_gate "$wt" dev-create-pr "$P")" 'a relative path resolves to the root from a worktree'
assert_pass "$(run_gate "$wt" dev-create-pr "$repo/$P")" 'an absolute root path resolves from a worktree'
mkdir -p "$wt/docs/plans" && cp "$repo/$P" "$wt/$P"
sed -i 's/Status: reviewed/Status: implemented/' "$repo/$P"
assert_block "$(run_gate "$wt" dev-create-pr "$P")" 'run review-code first' 'a stale worktree copy cannot override the root status'
assert_block "$(run_gate "$wt" dev-create-pr "$wt/$P")" 'not found' 'an absolute worktree path is not a root plan'
out=$(
  git() { if [[ "${1:-}" == worktree && "${2:-}" == list ]]; then return 1; fi; command git "$@"; }
  export -f git
  run_gate "$wt" dev-execute-feature "$P"
)
assert_block "$out" 'main working-tree root' 'failed root discovery does not adopt a linked-worktree plan'

# ── review-feature ──
repo=$(new_repo)
write_plan "$repo/$P" planning
assert_pass "$(run_gate "$repo" dev-review-feature "$P")" 'a closed planning plan enters review-feature'
write_plan "$repo/$P" approved
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'already approved' 'an approved plan does not re-enter review'
write_plan "$repo/$P" implemented
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'too late for review-feature' 'an implemented plan does not re-enter review'
write_plan "$repo/docs/plans/0_feature_gate.spec.md" planning '' "$(valid_graph)" feature none
assert_pass "$(run_gate "$repo" dev-review-feature docs/plans/0_feature_gate.spec.md)" 'Issue: none with issue 0 enters review'
write_plan "$repo/$P" planning '' "$(valid_graph)" feature none
assert_block "$(run_gate "$repo" dev-review-feature "$P")" "starts with 12, but the header has 'Issue: none'" 'Issue: none needs issue 0 in the filename'
write_plan "$repo/$P" planning '' "$(valid_graph)" feature '#13'
assert_block "$(run_gate "$repo" dev-review-feature "$P")" "starts with 12, but the header has 'Issue: #13'" 'the filename issue matches the header'
write_plan "$repo/$P" planning '' "$(valid_graph)" feature '#12abc'
assert_block "$(run_gate "$repo" dev-review-feature "$P")" "write 'Issue: #<n>' or 'Issue: none'" 'a malformed issue blocks'
write_plan "$repo/$P" planning '' "$(valid_graph)" fix
assert_block "$(run_gate "$repo" dev-review-feature "$P")" "type 'feature', but the header has 'Type: fix'" 'the filename type matches the header'
write_plan "$repo/$P" planning
sed -i 's/| Base: main |/| Base: |/' "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'no Base branch' 'review requires a Base'
write_plan "$repo/$P" planning
sed -i 's/| PR-1 | feat\/gate | main |/| PR-1 | feat\/gate | |/' "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'no Parent for PR-1' 'review requires PR-1 Parent'
write_plan "$repo/$P" planning '' "$(graph_n 2)"
sed -i 's/| ST-1, ST-2 |/| ST-1 |/' "$repo/$P"
printf '| PR-2 | feat/gate-2 | | ST-2 | second |\n' >> "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'without a Parent' 'a later row needs a Parent too'
sed -i 's/| PR-2 | feat\/gate-2 | |/| PR-2 | feat\/gate-2 | feat\/gate |/' "$repo/$P"
assert_pass "$(run_gate "$repo" dev-review-feature "$P")" 'a two-slice plan with parents enters review'

# ── ID shape ──
review_graph 'eight ACs enter review without a cap' "$(graph_n 8)" ''
review_graph 'a bulleted plan resolves the same graph' '## Acceptance Criteria
- AC-1 — outcome
## Test Cases
- TC-1 — scenario
  - Proves: AC-1
## Implementation Steps
- ST-1 — action — satisfies TC-1' ''
review_graph 'a template-verbatim plan enters review' '## Design Decisions
DD-1 — reject at the API so every client gets AC-1
  Options: API or UI | Choice: API, by the user | Why: one enforcement point
## Acceptance Criteria
AC-1 — an archived user cannot check out
  Source: issue #12
  Success: checkout returns 403
  Failure: an order is created
## Test Cases
TC-1 — archived user checks out
  Proves: AC-1
  Fixture: user u1, archived, cart with one item
  Action: POST /checkout as u1
  Expected: 403 and no order row
  Test: <path::name, filled by execute-feature>
## Implementation Steps
ST-1 — guard checkout in api/checkout.py — satisfies TC-1
  PC-1 — checkout reads the user before writing — Check: rg -n "get_user" api/checkout.py' ''
review_graph 'an unindented Proves: still belongs to its TC' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1' ''
review_graph 'an em-dash title naming another ID is not a range' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — TC-1 variant with an empty cart
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1, TC-2' ''
review_graph 'a numeric em-dash summary is not a range' '## Acceptance Criteria
AC-1 — the endpoint returns 200
## Test Cases
TC-1 — 200 returned for a valid request
  Proves: AC-1
## Implementation Steps
ST-1 — add the handler — satisfies TC-1' ''
review_graph 'word-embedded tokens are not IDs' '## Acceptance Criteria
AC-1 — the response carries UTC-7 offsets and an SHA-256 digest
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1' ''
review_graph 'fenced text is not parsed' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
~~~text
TC-9 sample output, docs/plans/be.md#AC-2
~~~
## Implementation Steps
ST-1 — action — satisfies TC-1' ''
review_graph 'an AC no TC proves blocks' '## Acceptance Criteria
AC-1 — outcome
AC-2 — second outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1' 'AC-2 has no TC'
review_graph 'a TC no step names blocks' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — second
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1' 'TC-2 is not satisfied by any Implementation Step'
review_graph 'a step naming no TC blocks' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1
ST-2 — unrelated cleanup' 'ST-2 has no satisfies clause naming a TC'
review_graph 'a TC with no Proves: blocks' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — scenario with no Proves line
  Fixture: setup
## Implementation Steps
ST-1 — action — satisfies TC-1 and TC-2' 'TC-2 has no Proves: line'
review_graph 'an undeclared TC blocks' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1/TC-9' 'cites TC-9, which is not declared'
review_graph 'an undeclared decision blocks' '## Acceptance Criteria
AC-1 — outcome per DD-2
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1' 'cites DD-2, which is not declared: no line in ## Design Decisions'
review_graph 'a checkbox TC is not a declaration' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
- [ ] TC-2 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1, TC-2' 'cites TC-2, which is not declared'
for case in 'TC-1 through TC-4' 'TC-1 to TC-4' 'TC-1–9' 'TC-1..TC-3'; do
  review_graph "'$case' is an unreadable range" "## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies $case" 'uses an ID range'
done
review_graph 'a Proves: naming no AC is unreadable' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: the login AC
## Implementation Steps
ST-1 — action — satisfies TC-1' 'unparseable Proves:'
review_graph 'a TC proving two ACs is unreadable' '## Acceptance Criteria
AC-1 — outcome
AC-2 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1, AC-2
## Implementation Steps
ST-1 — action — satisfies TC-1' 'exactly one is required'
review_graph 'two Proves: lines are unreadable' '## Acceptance Criteria
AC-1 — outcome
AC-2 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
  Proves: AC-2
## Implementation Steps
ST-1 — action — satisfies TC-1' 'more than one Proves:'
for id in AC TC ST; do
  review_graph "a duplicate $id is unreadable" "$(graph_n 2 | sed "s/$id-2/$id-1/")" 'declared more than once'
done
review_graph 'a leading zero is unreadable' "$(graph_n 1 | sed 's/AC-1/AC-01/g')" 'leading zero'
review_graph 'an ID of zero is unreadable' "$(graph_n 1 | sed 's/AC-1/AC-0/g')" 'IDs start at 1'
for cite in 'docs/plans/be.md#AC-2' 'docs/plans/be#AC-2' 'api/orders.yaml#DD-1'; do
  review_graph "'$cite' cites another artifact" "$(graph_n 1)
## Context
Relies on $cite" "cites another artifact's IDs"
done

repo=$(new_repo)
write_plan "$repo/$P" planning '' "$(graph_n 2)"
sed -i 's/| ST-1, ST-2 |/| ST-1 |/' "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'ST-2 is not assigned to any PR row' 'every step belongs to a PR row'
printf '| PR-2 | feat/gate-2 | feat/gate | ST-1, ST-2 | builds on ST-1 |\n' >> "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'ST-1 is assigned to more than one PR row' 'a step belongs to one PR row'
write_plan "$repo/$P" planning '' "$(graph_n 2)"
sed -i 's/| ST-1, ST-2 | test |/| ST-1 | test |/' "$repo/$P"
printf '| PR-2 | feat/gate-2 | feat/gate | ST-2 | builds on ST-1 |\n' >> "$repo/$P"
assert_pass "$(run_gate "$repo" dev-review-feature "$P")" 'a Summary that mentions a step does not own it'
sed -i 's/^ST-2 — do 2 — satisfies TC-2/ST-2 — do 2 — satisfies TC-2, TC-1/' "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'TC-1 belongs to more than one PR row (PR-1 PR-2)' 'a TC belongs to one PR row'
sed -i 's/^ST-2 — do 2 — satisfies TC-2, TC-1/ST-2 — extend the TC-1 handler — satisfies TC-2/' "$repo/$P"
assert_pass "$(run_gate "$repo" dev-review-feature "$P")" 'a step that mentions another TC in prose does not take its slice'

repo=$(new_repo)
write_plan "$repo/$P" planning '' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — do 1
  satisfies TC-1
ST-2 — do 2 — satisfies TC-1'
sed -i 's/| ST-1, ST-2 | test |/| ST-1 | test |/' "$repo/$P"
printf '| PR-2 | feat/gate-2 | feat/gate | ST-2 | two |\n' >> "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-feature "$P")" 'TC-1 belongs to more than one PR row (PR-1 PR-2)' 'a satisfies clause on a continuation line counts'
review_graph 'a step that only mentions a TC in prose satisfies nothing' "$(graph_n 1)
ST-2 — extend the TC-1 handler" 'ST-2 has no satisfies clause naming a TC'

# ── failing closed ──
repo=$(new_repo)
write_plan "$repo/$P" planning
printf '\xff\xfe stray bytes\n' >> "$repo/$P"
assert_pass "$(run_gate "$repo" dev-review-feature "$P")" 'invalid bytes in a plan reach a verdict'
crash=$(mktemp -d "$TMP_ROOT/crash.XXXXXX")
printf '#!/bin/bash\nfor a; do [[ "$a" == *owner*AC* ]] && exit 134; done\nexec %q "$@"\n' "$(command -v awk)" > "$crash/awk"
chmod +x "$crash/awk"
out=$(jq -cn --arg a "$P" '{tool_input:{skill:"dev-review-feature",args:$a}}' | (cd "$repo" && PATH="$crash:$PATH" "$GATE") || true)
assert_block "$out" 'gate-check failed (exit 134)' 'a crash in a gated phase blocks'

# ── Stacks On: a stacked plan waits for its parent ──
BE=docs/plans/12_feature_orders-api.spec.md
FE=docs/plans/12_feature_orders-web.spec.md
fe_repo() {
  local r
  r=$(new_repo)
  write_plan "$r/$BE" "$1"
  write_plan "$r/$FE" "$2" '' "$(valid_graph)" feature '#12' "Stacks On: $BE"
  sed -i 's/| feat\/gate | main |/| feat\/fe | feat\/gate |/' "$r/$FE"
  printf '%s\n' "$r"
}
repo=$(fe_repo planning planning)
assert_block "$(run_gate "$repo" dev-review-feature "$FE")" "Parent plan $BE is 'planning'; review-feature needs it 'approved' or later" 'review waits for the parent approval'
assert_block "$(run_gate "$repo" dev-review-feature "$FE $BE")" 'takes one plan path' 'naming the parent beside the plan blocks'
assert_pass "$(run_gate "$repo" dev-review-feature "$BE")" 'the root plan reviews on its own'
repo=$(fe_repo approved planning)
assert_pass "$(run_gate "$repo" dev-review-feature "$FE")" 'review enters once the parent is approved'
sed -i 's/| feat\/fe | feat\/gate |/| feat\/fe | main |/' "$repo/$FE"
assert_block "$(run_gate "$repo" dev-review-feature "$FE")" "a stacked plan's PR-1 Parent is its parent plan's last branch, 'feat/gate'" 'a stacked plan must stack on the parent last branch'
sed -i 's/| feat\/fe | main |/| feat\/fe | feat\/gate |/; s/| Base: main |/| Base: feat\/gate |/' "$repo/$FE"
assert_block "$(run_gate "$repo" dev-review-feature "$FE")" "a stacked plan uses its parent's Base" 'a stacked plan must share the parent Base'
printf 'Stacks On: %s\n' "$FE" > "$TMP_ROOT/stacks"
sed -i "/^Status:/r $TMP_ROOT/stacks" "$repo/$BE"
sed -i 's/| Base: feat\/gate |/| Base: main |/' "$repo/$FE"
assert_block "$(run_gate "$repo" dev-review-feature "$FE")" "lines form a cycle" 'a Stacks On cycle blocks'
repo=$(fe_repo implemented approved)
assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" "is 'implemented'; execute-feature needs it 'reviewed' or later" 'execution waits for the parent review'
repo=$(fe_repo reviewed approved)
assert_pass "$(run_gate "$repo" dev-execute-feature "$FE")" 'execution enters once the parent is reviewed'
sed -i 's/| PR-1 | feat\/gate | main |\(.*\)$/&\n| PR-2 | feat\/gate-2 | feat\/gate |\1/' "$repo/$BE"
assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" "parent plan's last branch, 'feat/gate-2'" 'execution rechecks its Parent after a parent revision'
repo=$(fe_repo reviewed approved)
commit_plan "$repo" "$BE"
assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" 'is merged, so its stack is complete' 'a merged plan cannot be a parent'
repo=$(fe_repo reviewed approved)
git -C "$repo" switch -q -c archive && commit_plan "$repo" "$BE" && git -C "$repo" switch -q main
assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" 'is published but not merged' 'an archived, unmerged plan cannot be a parent'
repo=$(fe_repo reviewed approved)
sed -i "s#^Stacks On: .*#Stacks On: docs/plans/12_feature_typo-api.spec.md#" "$repo/$FE"
assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" "does not exist. Fix the 'Stacks On:' path" 'a mistyped Stacks On blocks'
sed -i "s#^Stacks On: .*#Stacks On: <docs/plans/... of the parent plan; stacked plans only>#" "$repo/$FE"
assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" "names no docs/plans/<issue>_<type>_<slug>.spec.md" 'a placeholder Stacks On blocks'
sed -i "s#^Stacks On: .*#Stacks On: ../elsewhere/docs/plans/x.md#" "$repo/$FE"
assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" "names no docs/plans/<issue>_<type>_<slug>.spec.md" 'a foreign Stacks On blocks'
for line in "  Stacks On: $BE" "- Stacks On: $BE" "**Stacks On:** $BE" "Stacks On:" "stacks on: $BE"; do
  awk -v l="$line" 'tolower($0) ~ /stacks on/ { next } { print } /^Status:/ { print l }' "$repo/$FE" > "$TMP_ROOT/fe" && cp "$TMP_ROOT/fe" "$repo/$FE"
  assert_block "$(run_gate "$repo" dev-execute-feature "$FE")" "'Stacks On:' line that is misplaced" "a Stacks On line written as '$line' blocks"
done

# ── execute-feature ──
repo=$(new_repo)
write_plan "$repo/$P" planning
assert_block "$(run_gate "$repo" dev-execute-feature "$P")" 'not approved' 'a planning plan does not execute'
write_plan "$repo/$P" implemented
assert_block "$(run_gate "$repo" dev-execute-feature "$P")" 'already implemented' 'an implemented plan does not re-execute'
repo=$(new_repo)
plan_with_worktree "$repo" approved >/dev/null
assert_pass "$(run_gate "$repo" dev-execute-feature "$P")" 'an approved plan with a worktree resumes'

# ── review-code ──
repo=$(new_repo)
write_plan "$repo/$P" implemented
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'Plan records no Worktree' 'review-code needs the worktree'
write_plan "$repo/$P" reviewed
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'already reviewed' 'status is checked before an empty Worktree'
repo=$(new_repo)
wt=$(plan_with_worktree "$repo" approved)
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'not yet implemented' 'an approved plan is not reviewed'
sed -i 's/Status: approved/Status: implemented/' "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-code "$P")" "Found 0 'test(red):'" 'review requires a RED commit'
wt_commit "$wt" 'test(red): gate' tests/gate_test.py
wt_commit "$wt" 'feat(gate): implement' src/gate.py
assert_pass "$(run_gate "$repo" dev-review-code "$P")" 'RED then implementation enters review'
assert_pass "$(run_gate "$wt" dev-review-code "$P")" 'from the worktree, the root plan and worktree history combine'
write_plan "$repo/$P" implemented "$wt" '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — added during execution
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1'
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'TC-2 is not satisfied by any Implementation Step' 'review-code re-checks closure'

repo=$(new_repo)
wt=$(plan_with_worktree "$repo" implemented)
wt_commit "$wt" 'chore: setup' src/gate.py
wt_commit "$wt" 'test(red): gate' tests/gate_test.py
wt_commit "$wt" 'feat(gate): implement' src/gate.py
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'out of sequence' 'a commit before RED blocks'

repo=$(new_repo)
wt=$(plan_with_worktree "$repo" implemented)
wt_commit "$wt" 'test(red): gate' tests/gate_test.py
printf 'base moved\n' >> "$repo/README.md"
git -C "$repo" commit -qam 'chore: base moves'
git -C "$wt" merge -q --no-edit main
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'out of sequence' 'a merge after RED is not an implementation'

repo=$(new_repo)
P_REF=docs/plans/12_refactor_gate.spec.md
git -C "$repo" worktree add -q -b feat/gate "$repo-wt" main
write_plan "$repo/$P_REF" implemented "$repo-wt" "$(valid_graph)" refactor
wt_commit "$repo-wt" 'test(red): gate' tests/gate_test.py
wt_commit "$repo-wt" 'refactor: split' src/gate.py
assert_block "$(run_gate "$repo" dev-review-code "$P_REF")" "Found 0 'test: baseline'" 'a refactor proves with a baseline commit'
git -C "$repo-wt" reset -q --hard main
wt_commit "$repo-wt" 'test: baseline gate' tests/gate_test.py
wt_commit "$repo-wt" 'refactor: split' src/gate.py
assert_pass "$(run_gate "$repo" dev-review-code "$P_REF")" 'baseline then refactor enters review'

# Proof starts at PR-1's Parent: an unmerged parent's history is not this plan's.
repo=$(new_repo)
git -C "$repo" checkout -qb feat/parent
printf 'parent\n' > "$repo/parent.txt"
git -C "$repo" add parent.txt && git -C "$repo" commit -qm 'feat: parent work'
git -C "$repo" checkout -q main
wt=$(plan_with_worktree "$repo" implemented)
git -C "$wt" merge -q --ff-only feat/parent
sed -i 's/| feat\/gate | main |/| feat\/gate | feat\/parent |/' "$repo/$P"
wt_commit "$wt" 'test(red): gate' tests/gate_test.py
wt_commit "$wt" 'feat(gate): implement' src/gate.py
assert_pass "$(run_gate "$repo" dev-review-code "$P")" 'proof starts at the recorded Parent'
sed -i 's/| feat\/gate | feat\/parent |/| feat\/gate | |/' "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-code "$P")" 'no Parent for PR-1' 'review does not default a missing Parent'

# A repair to PR-1 merged into PR-2 reads as one line of history even when
# commit dates interleave the slices.
repo=$(new_repo)
wt="$repo-wt"
git -C "$repo" worktree add -q -b feat/s1 "$wt" main
dated() { GIT_AUTHOR_DATE="@$1 +0000" GIT_COMMITTER_DATE="@$1 +0000" wt_commit "$wt" "$2" "$3"; }
dated 1700000001 'test(red): s1' tests/s1_test.py
dated 1700000002 'feat(s1): implement' src/s1.py
git -C "$wt" switch -q -c feat/s2 feat/s1
dated 1700000003 'test(red): s2' tests/s2_test.py
git -C "$wt" switch -q feat/s1
dated 1700000004 'test(red): s1 repair' tests/s1_test.py
git -C "$wt" switch -q feat/s2
dated 1700000005 'feat(s2): implement' src/s2.py
git -C "$wt" switch -q feat/s1
dated 1700000006 'fix(s1): repair' src/s1.py
git -C "$wt" switch -q feat/s2
GIT_AUTHOR_DATE='@1700000007 +0000' GIT_COMMITTER_DATE='@1700000007 +0000' git -C "$wt" merge -q --no-edit feat/s1
write_plan "$repo/$P" implemented "$wt" "$(graph_n 2)"
sed -i 's#| PR-1 | feat/gate | main | ST-1, ST-2 | test |#| PR-1 | feat/s1 | main | ST-1 | one |\n| PR-2 | feat/s2 | feat/s1 | ST-2 | two |#' "$repo/$P"
assert_pass "$(run_gate "$repo" dev-review-code "$P")" 'a repair merged forward passes despite interleaved dates'

# Stacked review base: the parent plan's last branch, ahead only by its archive commit,
# possibly only on origin after cleanup.
repo=$(new_repo)
git -C "$repo" worktree add -q -b feat/be "$repo-be" main
wt_commit "$repo-be" 'test(red): be' tests/be_test.py
wt_commit "$repo-be" 'feat(be): implement' src/be.py
wt=$(plan_with_worktree "$repo" implemented)
git -C "$wt" merge -q --ff-only feat/be
sed -i 's/| feat\/gate | main |/| feat\/gate | feat\/be |/' "$repo/$P"
wt_commit "$wt" 'test(red): fe' tests/fe_test.py
wt_commit "$wt" 'feat(fe): implement' src/fe.py
mkdir -p "$repo-be/docs/plans" && printf 'archived\n' > "$repo-be/$BE"
git -C "$repo-be" add -f "$BE" && git -C "$repo-be" commit -qm 'docs(plan): archive be'
assert_pass "$(run_gate "$repo" dev-review-code "$P")" 'a Parent ahead only by its plan archive enters review'
git -C "$repo" update-ref refs/remotes/origin/feat/be feat/be
git -C "$repo" worktree remove "$repo-be"
git -C "$repo" branch -q -D feat/be
assert_pass "$(run_gate "$repo" dev-review-code "$P")" 'a Parent only on origin resolves'
git -C "$repo" worktree add -q "$repo-late" origin/feat/be 2>/dev/null
wt_commit "$repo-late" 'feat(be): late change' src/be.py
git -C "$repo" update-ref refs/remotes/origin/feat/be "$(git -C "$repo-late" rev-parse HEAD)"
assert_block "$(run_gate "$repo" dev-review-code "$P")" "Parent 'feat/be' is missing or is not an ancestor" 'a code change on the Parent blocks'
git -C "$repo-late" reset -q --hard HEAD~1
git -C "$repo-late" mv src/be.py docs/plans/moved.md
git -C "$repo-late" commit -qm 'chore: move be'
git -C "$repo" update-ref refs/remotes/origin/feat/be "$(git -C "$repo-late" rev-parse HEAD)"
assert_block "$(run_gate "$repo" dev-review-code "$P")" "Parent 'feat/be' is missing or is not an ancestor" 'code renamed into docs/plans/ on the Parent blocks'

# Base may advance without the slice merging it; review starts at the fork.
repo=$(new_repo)
wt=$(plan_with_worktree "$repo" implemented)
wt_commit "$wt" 'test(red): gate' tests/gate_test.py
wt_commit "$wt" 'feat(gate): implement' src/gate.py
printf 'moved\n' >> "$repo/README.md" && git -C "$repo" commit -qam 'chore: base moves'
assert_pass "$(run_gate "$repo" dev-review-code "$P")" 'Base advancing without a merge does not block review'

# origin/<Base> wins over a stale local Base, as in dev-publish.sh.
repo=$(new_repo)
git -C "$repo" checkout -qb up
printf 'upstream\n' > "$repo/up.txt" && git -C "$repo" add up.txt && git -C "$repo" commit -qm 'feat: upstream'
git -C "$repo" update-ref refs/remotes/origin/main up
git -C "$repo" checkout -q main && git -C "$repo" branch -q -D up
git -C "$repo" worktree add -q -b feat/gate "$repo-wt" origin/main
write_plan "$repo/$P" implemented "$repo-wt"
wt_commit "$repo-wt" 'test(red): gate' tests/gate_test.py
wt_commit "$repo-wt" 'feat(gate): implement' src/gate.py
assert_pass "$(run_gate "$repo" dev-review-code "$P")" 'a slice from origin/<Base> reviews from it when local Base is behind'

repo=$(new_repo)
write_plan "$repo/$BE" implemented
plan_with_worktree "$repo" implemented >/dev/null
sed -i "/^Status:/a Stacks On: $BE" "$repo/$P"
assert_block "$(run_gate "$repo" dev-review-code "$P")" "Parent plan $BE is 'implemented'; review-code needs it 'reviewed'" 'code review waits for a revised parent'

# ── create-pr ──
repo=$(new_repo)
write_plan "$repo/$P" reviewed
assert_block "$(run_gate "$repo" dev-create-pr "$P")" 'Plan records no Worktree' 'create-pr needs the worktree'
repo=$(new_repo)
plan_with_worktree "$repo" implemented >/dev/null
assert_block "$(run_gate "$repo" dev-create-pr "$P")" 'run review-code first' 'an implemented plan cannot skip review-code'
repo=$(new_repo)
plan_with_worktree "$repo" reviewed >/dev/null
# A tree: $P has children $FE and $MOB, and $FE has child $GC.
MOB=docs/plans/12_feature_orders-mobile.spec.md
GC=docs/plans/12_feature_orders-admin.spec.md
stack_on() {  # stack_on <plan> <status> <parent> <parent last branch> <own branch>
  write_plan "$repo/$1" "$2" "$repo-wt" "$(valid_graph)" feature '#12' "Stacks On: $3"
  sed -i "s#| feat/gate | main |#| $5 | $4 |#" "$repo/$1"
  printf 'Green: PR-1 (%s) at %s\n' "$5" "$green" >> "$repo/$1"
}
green=$(git -C "$repo" rev-parse feat/gate)
printf 'Green: PR-1 (feat/gate) at %s\n' "$green" >> "$repo/$P"
stack_on "$FE" implemented "$P" main feat/fe
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "Plan $FE has PR-1 Parent 'main'" 'publication rechecks that each plan above stacks correctly'
stack_on "$FE" implemented "$P" feat/gate feat/fe
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "Plan $FE stacks above this plan and is 'implemented'" 'the root waits for its child to be reviewed'
write_plan "$repo/$FE" planning '' "$(valid_graph)" feature '#12' 'Stacks On: docs/plan/typo.spec.md'
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "$FE has a 'Stacks On:' line that is misplaced" 'a malformed Stacks On elsewhere blocks publication'
stack_on "$FE" reviewed "$P" feat/gate feat/fe
stack_on "$MOB" reviewed "$P" feat/gate feat/mob
stack_on "$GC" approved "$FE" feat/fe feat/gc
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "Plan $GC stacks above this plan and is 'approved'" 'the root waits for a grandchild to be reviewed'
stack_on "$GC" reviewed "$FE" feat/fe feat/gc
assert_pass "$(run_gate "$repo" dev-create-pr "$P")" 'the root publishes once every plan in its tree is reviewed'
stale=$green
wt_commit "$repo-wt" 'fix: root repair' src/root.py
printf 'Green: PR-1 (feat/gate) at %s\n' "$(git -C "$repo-wt" rev-parse HEAD)" >> "$repo/$P"
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "does not contain its parent $P's last Green" 'a child reviewed before a root repair blocks publication'
green=$(git -C "$repo-wt" rev-parse HEAD)
stack_on "$FE" reviewed "$P" feat/gate feat/fe
stack_on "$MOB" reviewed "$P" feat/gate feat/mob
stack_on "$GC" reviewed "$FE" feat/fe feat/gc
assert_pass "$(run_gate "$repo" dev-create-pr "$P")" 'children re-reviewed on the repaired root publish'
sed -i '/^Green:/d' "$repo/$FE"
printf -- '- Green: PR-1 (feat/fe) at %s, recorded by review-code\n' "$stale" >> "$repo/$FE"
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "Plan $FE's PR-1 Green $stale does not contain" 'a bulleted Green line with trailing text is read'
sed -i '/Green:/d' "$repo/$FE"
printf -- '- Green: PR-1 (feat/fe) at %s, recorded by review-code\n' "$green" >> "$repo/$FE"
assert_pass "$(run_gate "$repo" dev-create-pr "$P")" 'a bulleted Green line with trailing text counts'
printf '\n```\nStacks On: docs/plans/12_feature_example.spec.md\n```\n' >> "$repo/$GC"
assert_pass "$(run_gate "$repo" dev-create-pr "$P")" 'a Stacks On line in a fenced block is not the header'
stack_on "$GC" reviewed "docs/plans/./${FE#docs/plans/}" feat/fe feat/gc
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "$GC has a 'Stacks On:' line that is misplaced" 'a Stacks On path other than the literal plan path blocks'
stack_on "$GC" reviewed "$FE" feat/fe feat/gc
sed -i '2i ```' "$repo/$GC"
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "$GC has a 'Stacks On:' line that is misplaced" 'an unclosed fence blocks'
stack_on "$GC" reviewed "$FE" feat/fe feat/gc
ln -s "${GC#docs/plans/}" "$repo/docs/plans/12_feature_orders-link.spec.md"
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "12_feature_orders-link.spec.md has a 'Stacks On:' line" 'a symlinked plan blocks publication'
rm "$repo/docs/plans/12_feature_orders-link.spec.md"
sed -i "/^Stacks On:/d; /^## Goal/a Stacks On: $FE" "$repo/$GC"
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "$GC has a 'Stacks On:' line that is misplaced" 'a Stacks On line below the header blocks'
stack_on "$GC" reviewed docs/plans/12_feature_gone.spec.md feat/fe feat/gc
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "$GC has a 'Stacks On:' line that is misplaced, repeated, or names no live" 'a child of a missing plan blocks publication'
stack_on "$GC" reviewed "$FE" feat/fe feat/gc
assert_block "$(run_gate "$repo" dev-create-pr "$FE")" "create-pr runs once, on the stack's root $P" 'create-pr on a stacked plan names the root'
sed -i "s#^\(Status:.*Worktree: \).*#\1$repo-gone#" "$repo/$GC"
assert_block "$(run_gate "$repo" dev-create-pr "$P")" "Plan $GC records 'Worktree: $repo-gone'" 'publication needs every worktree in the stack'
printf 'All gate-check tests passed. Temporary fixtures: %s\n' "$TMP_ROOT"
