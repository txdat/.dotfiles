bad_graph 'a checkbox TC is not a declaration and does not steal the previous TC'"'"'s Proves:' '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
- [ ] TC-2 — scenario
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1, TC-2' 'cites TC-2, which is not declared'

repo=$(id_plan '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
~~~text
TC-9 sample output
~~~
## Implementation Steps
ST-1 — action — satisfies TC-1')
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'a tilde fence is not parsed for IDs'

repo=$(id_plan "$(graph_with_acs 2)")
sed -i 's/| ST-1, ST-2 | test |/| ST-1 | test |/' "$repo/docs/plans/gate.md"
printf '| PR-2 | feature/gate-test-2 | feature/gate-test | ST-2 | builds on ST-1 |\n' >> "$repo/docs/plans/gate.md"
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'a Summary that mentions a step does not own it'

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
output=$(prompt_gate "$repo" '/dev-execute-feature, docs/plans/gate.md')
assert_block "$output" 'not approved' 'punctuation after a typed skill still gates it'
output=$(prompt_gate "$repo" '/Dev-execute-feature docs/plans/gate.md')
assert_block "$output" 'not approved' 'a typed skill is gated regardless of case'
assert_pass "$(shim_prompt "$nojq" 'restart the dev-server')" 'missing jq does not block a prompt that mentions dev-'

# ── Second review round regressions ──
# The design-feature template, filled in verbatim, enters review.
repo=$(id_plan '## Context
Balances are read on every checkout.
## Acceptance Criteria
AC-1 — an archived user cannot check out
  Source: issue #12
  Success: checkout returns 403
  Failure: an order is created
## Test Fixtures
FX-1 — user u1, archived, cart with one item
## Test Cases (intent)
TC-1 — archived user checks out
  Proves: AC-1
  Fixture: FX-1 with no overrides
  Action: POST /checkout as u1
  Expected: 403 and no order row
  Test: <path::name, filled during execution>
## Implementation Steps
ST-1 — guard checkout in api/checkout.py — satisfies TC-1
  PC-1 — checkout reads the user before writing — Check: rg -n "get_user" api/checkout.py
## Design Decisions
DD-1 — reject at the API, not the UI, so every client gets AC-1
## Open Risks
RK-1 — the archive flag may lag replication — TC-1')
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'a template-verbatim plan enters review-feature'

repo=$(id_plan '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1')
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'an unindented Proves: still belongs to its TC'

repo=$(id_plan '## Acceptance Criteria
AC-1 — outcome
## Test Cases
TC-1 — scenario
  Proves: AC-1
TC-2 — TC-1 variant with an empty cart
  Proves: AC-1
## Implementation Steps
ST-1 — action — satisfies TC-1, TC-2')
output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
assert_pass "$output" 'an em-dash title that names another ID is not a range'

for heading in '## Open question' '## Questions' '## Assumption'; do
  repo=$(new_repo)
  write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
  printf '\n%s\n' "$heading" >> "$repo/docs/plans/gate.md"
  output=$(run_gate "$repo" dev-review-feature 'docs/plans/gate.md')
  assert_block "$output" 'parks Assumptions or Open Questions' "'$heading' is an open-questions container"
done

repo=$(new_repo)
write_plan "$repo/docs/plans/gate.md" planning feature '#12' '' '## PR Pattern (provisional)'
output=$(jq -cn '{hook_event_name:"PreToolUse",tool_name:"run_shell_command",tool_input:{command:"git commit -m \"dev-review-code notes\""}}' | (cd "$repo" && "$GATE"))
assert_pass "$output" 'a shell command that mentions a dev skill is not an invocation'
output=$(jq -cn '{hook_event_name:"PreToolUse",tool_name:"SlashCommand",tool_input:{command:"/dev-execute-feature docs/plans/gate.md"}}' | (cd "$repo" && "$GATE"))
assert_block "$output" 'not approved' 'a slash command in a command field still gates'

mkdir -p "$repo/docs/architecture"
printf '%s\n' '# Events' 'Status: draft' '' '## Contracts' 'CT-1 — order event' '## Decomposition' 'DC-1 — orders plan — CT-9 — emits — contract test' > "$repo/docs/architecture/events.md"
output=$(run_gate "$repo" dev-review-system 'docs/architecture/events.md')
assert_block "$output" 'cites IDs it does not declare' 'a non-plan artifact is not told about a plan graph'

printf 'All gate-check tests passed. Temporary fixtures: %s\n' "$TMP_ROOT"
