{
  "name": "typescript-lsp",
  "description": "TypeScript/JavaScript language server",
  "version": "1.0.0",
  "author": {
    "name": "txdat"
  },
  "lspServers": {
    "vtsls": {
      "command": "vtsls",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "startupTimeout": 30000
    }
  }
}
