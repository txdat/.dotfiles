[user]
    name = txdat
    email = dattranx105@gmail.com

[core]
    pager = delta
    excludesFile = ~/.dotfiles/.gitignore_global
	gitproxy = 
	autocrlf = false

[credential]
    helper = cache

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictstyle = diff3

[diff]
    algorithm = patience
    colorMoved = default
    compactionHeuristic = true

[delta]
    true-color = always
    line-numbers = true
    navigate = true
    conflictstyle = diff3
    diffFilter = delta --color-only
[init]
    defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
